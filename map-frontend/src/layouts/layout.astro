---
import '../styles/global.css';
import Header from '../components/header.astro';
import InquiryWidget from '../components/InquiryWidget.astro';
import Footer from '../components/footer.astro';
import { absoluteUrl, DEFAULT_DESCRIPTION, DEFAULT_OG_IMAGE, DEFAULT_TITLE, SITE_NAME, withBasePath } from '../data/site';

type Props = {
	title?: string;
	description?: string;
	canonicalPath?: string;
	image?: string;
	imageAlt?: string;
	noindex?: boolean;
};

const {
	title: pageTitle,
	description = DEFAULT_DESCRIPTION,
	canonicalPath = Astro.url.pathname,
	image = DEFAULT_OG_IMAGE,
	imageAlt = "Interaktívna mapa reklamných plôch Billboardy.sk",
	noindex = false,
} = Astro.props as Props;

const title = pageTitle ? `${pageTitle} | ${SITE_NAME}` : DEFAULT_TITLE;
const canonicalUrl = absoluteUrl(canonicalPath);
const ogImageUrl = absoluteUrl(image);
const faviconSvg = withBasePath("favicon.svg");
const faviconIco = withBasePath("favicon.ico");
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const structuredData = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: SITE_NAME,
	url: absoluteUrl("/"),
	inLanguage: "sk-SK",
	publisher: {
		"@type": "Organization",
		name: SITE_NAME,
		url: absoluteUrl("/"),
		logo: absoluteUrl("/favicon.svg"),
	},
};
---

<html lang="sk">
	<head>
		<meta charset="utf-8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
		<link rel="icon" type="image/svg+xml" href={faviconSvg} />
		<link rel="icon" href={faviconIco} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={robotsContent} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:locale" content="sk_SK" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<title>{title}</title>
		<script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
	</head>

	<body class="min-h-screen bg-bb-surface text-bb-ink">
		<Header />
		<InquiryWidget />
			<main>
			<slot />
			</main>

		<Footer />
		<script>
			import "../scripts/contactForms";
		</script>
	</body>
</html>
