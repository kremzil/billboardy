---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/layout.astro";
import MhdOfferCard from "../components/MhdOfferCard.astro";
import {
	BUS_OFFERS,
	FLAG_RENTALS,
	SIT_RENTALS,
	STREET_CATEGORIES,
	TRAM_OFFERS,
	discountPrice,
	formatEuro,
} from "../data/mhdAdvertising";
import { CONTACT_EMAIL, CONTACT_PHONE_DISPLAY, CONTACT_PHONE_TEL } from "../data/site";

const basePath = import.meta.env.BASE_URL;
const contactHref = `${basePath}kontakt/`;
const title = "Reklama na autobusoch a električkách Košice";
const description =
	"Prenájom reklamných plôch na autobusoch, električkách a stĺpoch verejného osvetlenia v Košiciach. Ceny prenájmu sú o 3 % nižšie oproti cenníku DPMK.";
---

<Layout
	title={title}
	description={description}
	canonicalPath="/reklama-na-mhd-kosice/"
	image="/assets/mhd-kosice/hero-tram-kosice.webp"
	imageAlt="Električka MHD v Košiciach"
>
	<div class="min-h-screen overflow-x-clip bg-white">
		<div class="sticky top-16 z-40 border-b border-gray-100 bg-white/95 shadow-sm backdrop-blur">
			<div class="mx-auto flex h-14 max-w-7xl items-center gap-3 overflow-x-auto px-4 text-sm sm:px-6 lg:px-8">
				<a href={basePath} class="flex shrink-0 items-center gap-1.5 font-bold text-gray-500 transition-colors hover:text-gray-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2">
					<Icon name="lucide:arrow-left" width="15" height="15" />
					Späť
				</a>
				<span class="text-gray-300">/</span>
				<span class="shrink-0 text-xs font-semibold text-gray-400">Reklamné plochy</span>
				<span class="text-gray-300">/</span>
				<span class="shrink-0 font-extrabold text-bb-ink">MHD Košice</span>
			</div>
		</div>

		<section class="relative min-h-120 overflow-hidden">
			<img
				src="/assets/mhd-kosice/hero-tram-kosice.webp"
				alt="Električka MHD v Košiciach"
				loading="eager"
				decoding="async"
				fetchpriority="high"
				class="absolute inset-0 h-full w-full object-cover"
			/>
			<div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(21,23,25,0.9)_35%,rgba(21,23,25,0.3))]"></div>
			<div class="relative mx-auto flex min-h-120 max-w-7xl items-center px-4 py-16 sm:px-6 lg:px-8">
				<div class="max-w-3xl">
					<span class="mb-4 inline-flex rounded-full bg-brand px-3 py-1 text-xs font-extrabold text-white">MHD Košice</span>
					<h1 class="text-[clamp(2.4rem,5vw,3.75rem)] font-black leading-[1.04] text-white">Reklama na autobusoch a električkách v Košiciach</h1>
					<p class="mt-4 max-w-2xl text-[1.05rem] leading-relaxed text-gray-200">
						Oslovte Košičanov počas každodenných ciest. Vyberte si celoplošný polep, formát na vozidle alebo reklamu na verejnom osvetlení.
					</p>
					<div class="mt-7 flex flex-wrap gap-3">
						<a href="#autobusy" class="inline-flex items-center gap-2 rounded-xl bg-brand px-5 py-3 text-sm font-extrabold text-white transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-brand">
							Pozrieť reklamné plochy
							<Icon name="lucide:arrow-right" width="15" height="15" />
						</a>
						<a href={contactHref} class="inline-flex items-center rounded-xl border border-white/20 bg-white/10 px-5 py-3 text-sm font-extrabold text-white backdrop-blur-sm transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900">
							Vyžiadať ponuku
						</a>
					</div>
				</div>
			</div>
			<p class="absolute bottom-3 right-4 z-10 text-right text-[0.68rem] text-white/75 sm:right-6 lg:right-8">
				<a href="https://commons.wikimedia.org/wiki/File:Vario_LF2%2B_Ko%C5%A1ice_%C4%8D801.JPG" class="underline underline-offset-2 hover:text-white">Foto: Adehertogh / Wikimedia Commons</a>,
				<a href="https://creativecommons.org/licenses/by-sa/4.0/" class="underline underline-offset-2 hover:text-white">CC BY-SA 4.0</a>
			</p>
		</section>

		<div class="bg-brand">
			<div class="mx-auto grid max-w-7xl grid-cols-1 divide-y divide-white/20 px-4 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-6 lg:px-8">
				{["Košice", "Ceny bez DPH", "Kompletný servis"].map((fact) => (
					<div class="px-4 py-5 text-center text-lg font-black text-white">{fact}</div>
				))}
			</div>
		</div>

		<nav aria-label="Kategórie reklamy v MHD" class="sticky top-30 z-30 border-b border-gray-100 bg-white/95 shadow-sm backdrop-blur">
			<div class="mx-auto flex max-w-7xl gap-2 overflow-x-auto px-4 py-3 sm:px-6 lg:px-8">
				<a href="#autobusy" class="shrink-0 rounded-full bg-gray-100 px-4 py-2 text-sm font-extrabold text-gray-700 hover:bg-brand hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand">Autobusy</a>
				<a href="#elektricky" class="shrink-0 rounded-full bg-gray-100 px-4 py-2 text-sm font-extrabold text-gray-700 hover:bg-brand hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand">Električky</a>
				<a href="#verejne-osvetlenie" class="shrink-0 rounded-full bg-gray-100 px-4 py-2 text-sm font-extrabold text-gray-700 hover:bg-brand hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand">Verejné osvetlenie</a>
			</div>
		</nav>

		<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
			<section id="autobusy" class="scroll-mt-44">
				<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em] text-brand">Reklama na vozidlách</p>
				<h2 class="text-[2rem] font-black text-bb-ink">Autobusy</h2>
				<p class="mt-3 max-w-3xl leading-relaxed text-gray-600">Vyberte si z jedenástich formátov od celoplošného polepu po menšie bočné a zadné reklamné plochy.</p>
				<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
					{BUS_OFFERS.map((offer) => <MhdOfferCard offer={offer} />)}
				</div>
			</section>

			<section id="elektricky" class="scroll-mt-44 pt-20">
				<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em] text-brand">Reklama na vozidlách</p>
				<h2 class="text-[2rem] font-black text-bb-ink">Električky</h2>
				<p class="mt-3 max-w-3xl leading-relaxed text-gray-600">Výrazné plochy na električkách pre kampane, ktoré sa pohybujú naprieč Košicami.</p>
				<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
					{TRAM_OFFERS.map((offer) => <MhdOfferCard offer={offer} />)}
				</div>
			</section>

			<section id="verejne-osvetlenie" class="scroll-mt-44 pt-20">
				<div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1.65fr)_minmax(18rem,0.85fr)] lg:items-stretch">
					<div class="flex min-w-0 flex-col gap-6">
						<header class="rounded-2xl bg-gray-100 px-5 py-7 sm:px-7">
							<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em] text-brand">Reklama v uliciach</p>
							<h2 class="text-[2rem] font-black text-bb-ink sm:text-[2.35rem]">Verejné osvetlenie</h2>
							<p class="mt-3 max-w-2xl leading-relaxed text-gray-600">Smerové tabule a vlajky dopĺňajú ponuku reklamných plôch v košických uliciach.</p>
						</header>

						<article class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
							<div class="bg-bb-ink px-5 py-4 text-white sm:px-6">
								<h3 class="text-lg font-black">Smerové informačno-navádzacie tabule (SIT)</h3>
							</div>
							<div class="overflow-x-auto">
								<table class="w-full min-w-96 text-left text-sm" aria-label="Cenník smerových informačno-navádzacích tabúľ">
									<thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
										<tr><th scope="col" class="px-5 py-3">Typ</th><th scope="col" class="px-5 py-3">Obdobie</th><th scope="col" class="px-5 py-3 text-right">Cena prenájmu / mesiac</th></tr>
									</thead>
									<tbody class="divide-y divide-gray-100">
										{SIT_RENTALS.map((offer) => (
											<tr><th scope="row" class="px-5 py-3 font-bold text-bb-ink">{offer.title}</th><td class="px-5 py-3 text-gray-600">{offer.period}</td><td class="whitespace-nowrap px-5 py-3 text-right font-black">{formatEuro(discountPrice(offer.sourcePrice))}</td></tr>
										))}
									</tbody>
								</table>
							</div>
						</article>

						<article class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
							<div class="bg-brand px-5 py-4 text-white sm:px-6">
								<h3 class="text-lg font-black">VLAJKA na stĺpoch verejného osvetlenia</h3>
							</div>
							<div class="overflow-x-auto">
								<table class="w-full min-w-96 text-left text-sm" aria-label="Cenník vlajok na stĺpoch verejného osvetlenia">
									<thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
										<tr><th scope="col" class="px-5 py-3">Typ</th><th scope="col" class="px-5 py-3">Obdobie</th><th scope="col" class="px-5 py-3 text-right">Cena prenájmu</th></tr>
									</thead>
									<tbody class="divide-y divide-gray-100">
										{FLAG_RENTALS.map((offer) => (
											<tr><th scope="row" class="px-5 py-3 font-bold text-bb-ink">{offer.title}</th><td class="px-5 py-3 text-gray-600">{offer.period}</td><td class="whitespace-nowrap px-5 py-3 text-right font-black">{formatEuro(discountPrice(offer.sourcePrice))}</td></tr>
										))}
									</tbody>
								</table>
							</div>
						</article>

					</div>

					<aside data-street-categories class="flex min-h-[32rem] flex-col overflow-hidden rounded-2xl border border-gray-200 bg-gray-100 shadow-sm lg:h-full lg:max-h-[54rem]" aria-labelledby="street-category-title">
						<div class="bg-bb-ink px-5 py-4 text-white">
							<p class="text-xs font-bold uppercase tracking-[0.08em] text-white/60">Smerové tabule (SIT)</p>
							<h3 id="street-category-title" class="mt-1 text-lg font-black">Kategória ulíc</h3>
						</div>

						<div class="flex gap-2 border-b border-gray-200 bg-white p-3" role="tablist" aria-label="Kategória ulíc">
							{STREET_CATEGORIES.map((category, index) => (
								<button
									type="button"
									class="street-category-tab rounded-xl px-3 py-3 text-left text-sm font-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
									role="tab"
									id={`street-tab-${category.code}`}
									aria-controls={`street-panel-${category.code}`}
									aria-selected={index === 0 ? "true" : "false"}
									data-category-tab={category.code}
								>
									<span class="block text-lg">{category.code}</span>
									<span class="category-tab-label mt-0.5 block whitespace-nowrap text-[0.68rem] font-bold opacity-70">{category.items.length} {category.code === "C" ? "skupiny" : "ulíc"}</span>
								</button>
							))}
						</div>

						<div class="min-h-0 flex-1 p-3 sm:p-4">
							{STREET_CATEGORIES.map((category, index) => (
								<div
									class="h-full"
									role="tabpanel"
									id={`street-panel-${category.code}`}
									aria-labelledby={`street-tab-${category.code}`}
									data-category-panel={category.code}
									hidden={index !== 0}
								>
									<ul class="street-category-list grid max-h-[30rem] auto-rows-max content-start grid-cols-1 gap-2 overflow-y-auto pr-1 sm:grid-cols-2 lg:h-full lg:max-h-none lg:grid-cols-1" aria-label={`Ulice kategórie ${category.code}`}>
										{category.items.map((item) => <li class="rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm font-semibold text-gray-700 shadow-xs">{item}</li>)}
									</ul>
								</div>
							))}
						</div>
					</aside>
				</div>
			</section>
		</div>

		<section class="bg-bb-ink py-14">
			<div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
				<h2 class="mb-3 text-[1.8rem] font-black text-white">Máte záujem o reklamu v košickej MHD?</h2>
				<p class="mb-8 text-base text-white/60">Napíšte nám alebo zavolajte. Pripravíme ponuku podľa formátu a dĺžky kampane.</p>
				<div class="flex flex-wrap justify-center gap-3">
					<a href={contactHref} class="inline-flex items-center gap-2 rounded-xl bg-brand px-6 py-3 text-sm font-extrabold text-white transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-bb-ink">
						Vyžiadať ponuku
						<Icon name="lucide:arrow-right" width="15" height="15" />
					</a>
					<a href={`tel:${CONTACT_PHONE_TEL}`} class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-6 py-3 text-sm font-extrabold text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-bb-ink">
						<Icon name="lucide:phone" width="14" height="14" />
						{CONTACT_PHONE_DISPLAY}
					</a>
					<a href={`mailto:${CONTACT_EMAIL}`} class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-6 py-3 text-sm font-extrabold text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-bb-ink">
						<Icon name="lucide:mail" width="14" height="14" />
						{CONTACT_EMAIL}
					</a>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	.street-category-tab {
		min-width: 0;
		flex: 1 1 0%;
		background: #e5e7eb;
		color: #374151;
		transition: flex-grow 220ms ease, background-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
	}

	.street-category-tab[aria-selected="true"] {
		flex-grow: 2.5;
		background: #e30613;
		color: #fff;
		box-shadow: 0 8px 22px rgb(227 6 19 / 18%);
	}

	.street-category-tab:not([aria-selected="true"]) .category-tab-label {
		max-height: 0;
		margin-top: 0;
		opacity: 0;
		overflow: hidden;
	}

	.street-category-list {
		scrollbar-color: #c5c7cb transparent;
		scrollbar-width: thin;
	}

	@media (prefers-reduced-motion: reduce) {
		.street-category-tab {
			transition: none;
		}
	}
</style>

<script>
	const categoryContainers = document.querySelectorAll<HTMLElement>("[data-street-categories]");

	categoryContainers.forEach((container) => {
		const tabs = Array.from(container.querySelectorAll<HTMLButtonElement>("[data-category-tab]"));
		const panels = Array.from(container.querySelectorAll<HTMLElement>("[data-category-panel]"));

		const activateCategory = (code: string) => {
			tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.categoryTab === code)));
			panels.forEach((panel) => {
				const isActive = panel.dataset.categoryPanel === code;
				panel.hidden = !isActive;
				if (isActive) panel.querySelector<HTMLElement>(".street-category-list")?.scrollTo({ top: 0 });
			});
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener("click", () => activateCategory(tab.dataset.categoryTab ?? "A"));
			tab.addEventListener("keydown", (event) => {
				let nextIndex = index;
				if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
				else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
				else if (event.key === "Home") nextIndex = 0;
				else if (event.key === "End") nextIndex = tabs.length - 1;
				else return;

				event.preventDefault();
				const nextTab = tabs[nextIndex];
				nextTab?.focus();
				activateCategory(nextTab?.dataset.categoryTab ?? "A");
			});
		});
	});
</script>
