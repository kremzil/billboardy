---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/layout.astro";
import MhdOfferCard from "../components/MhdOfferCard.astro";
import {
	BUS_OFFERS,
	FLAG_RENTALS,
	SIT_RENTALS,
	STREET_CATEGORIES,
	TRAM_OFFERS,
	discountPrice,
	formatEuro,
} from "../data/mhdAdvertising";
import { CONTACT_EMAIL, CONTACT_PHONE_DISPLAY, CONTACT_PHONE_TEL } from "../data/site";

const basePath = import.meta.env.BASE_URL;
const contactHref = `${basePath}kontakt/`;
const title = "Reklama na autobusoch a električkách Košice";
const description =
	"Prenájom reklamných plôch na autobusoch, električkách a stĺpoch verejného osvetlenia v Košiciach. Ceny prenájmu sú o 3 % nižšie oproti cenníku DPMK.";

const MHD_ADVANTAGES = [
	{ icon: "lucide:eye", title: "Každodenný kontakt", desc: "Reklama sprevádza cestujúcich aj ľudí v uliciach počas bežného dňa." },
	{ icon: "lucide:route", title: "Pohyb po Košiciach", desc: "Vozidlá prenášajú kampaň medzi mestskými časťami a frekventovanými trasami." },
	{ icon: "lucide:layout-grid", title: "Výber rozsahu", desc: "Od celoplošného polepu po menšie plochy, smerové tabule a vlajky." },
	{ icon: "lucide:calendar-range", title: "Dlhodobá viditeľnosť", desc: "Formát a dĺžku prenájmu nastavíme podľa cieľa a rozsahu kampane." },
];

const MHD_SECTIONS = [
	{ href: "#autobusy", title: "Autobusy", desc: "Celoplošné polepy, bočné, dverové a zadné reklamné plochy.", badge: `${BUS_OFFERS.length} formátov` },
	{ href: "#elektricky", title: "Električky", desc: "Výrazné mobilné plochy pre kampane naprieč mestom.", badge: `${TRAM_OFFERS.length} formáty` },
	{ href: "#verejne-osvetlenie", title: "Verejné osvetlenie", desc: "Smerové tabule, vlajky a kategorizácia košických ulíc.", badge: "SIT + vlajka" },
];

const MHD_SPECS = [
	{ label: "Lokalita", value: "Košice" },
	{ label: "Nosiče", value: "Autobusy, električky, verejné osvetlenie" },
	{ label: "Formáty", value: "Celopolepy, menšie plochy, SIT a vlajky" },
	{ label: "Dĺžka kampane", value: "Od 1 mesiaca" },
	{ label: "Ceny", value: "Bez 23 % DPH" },
	{ label: "Prenájom", value: "O 3 % nižšie než cenník DPMK" },
	{ label: "Polep vozidla", value: "100 € bez DPH" },
];
---

<Layout
	title={title}
	description={description}
	canonicalPath="/reklama-na-mhd-kosice/"
	image="/assets/mhd-kosice/hero-tram-kosice.webp"
	imageAlt="Električka MHD v Košiciach"
>
	<div class="min-h-screen overflow-x-clip bg-white">
		<div class="sticky top-16 z-40 border-b border-gray-100 bg-white/95 shadow-sm backdrop-blur">
			<div class="mx-auto flex h-14 max-w-7xl items-center gap-3 overflow-x-auto px-4 text-sm sm:px-6 lg:px-8">
				<a href={basePath} class="flex shrink-0 items-center gap-1.5 font-bold text-gray-500 transition-colors hover:text-gray-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2">
					<Icon name="lucide:arrow-left" width="15" height="15" />
					Späť
				</a>
				<span class="text-gray-300">/</span>
				<span class="shrink-0 text-xs font-semibold text-gray-400">Reklamné plochy</span>
				<span class="text-gray-300">/</span>
				<span class="shrink-0 font-extrabold text-bb-ink">MHD Košice</span>
			</div>
		</div>

		<section class="relative min-h-120 overflow-hidden">
			<img
				src="/assets/mhd-kosice/hero-tram-kosice.webp"
				alt="Električka MHD v Košiciach"
				loading="eager"
				decoding="async"
				fetchpriority="high"
				class="absolute inset-0 h-full w-full object-cover"
			/>
			<div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(21,23,25,0.9)_35%,rgba(21,23,25,0.3))]"></div>
			<div class="relative mx-auto flex min-h-120 max-w-7xl items-center px-4 py-16 sm:px-6 lg:px-8">
				<div class="max-w-3xl">
					<span class="mb-4 inline-flex rounded-full bg-brand px-3 py-1 text-xs font-extrabold text-white">MHD Košice</span>
					<h1 class="text-[clamp(2.4rem,5vw,3.75rem)] font-black leading-[1.04] text-white">Reklama na autobusoch a električkách v Košiciach</h1>
					<p class="mt-4 max-w-2xl text-[1.05rem] leading-relaxed text-gray-200">
						Oslovte Košičanov počas každodenných ciest. Vyberte si celoplošný polep, formát na vozidle alebo reklamu na verejnom osvetlení.
					</p>
					<div class="mt-7 flex flex-wrap gap-3">
						<a href="#ponuka-mhd" class="inline-flex items-center gap-2 rounded-xl bg-brand px-5 py-3 text-sm font-extrabold text-white transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-brand">
							Pozrieť reklamné plochy
							<Icon name="lucide:arrow-right" width="15" height="15" />
						</a>
						<a href={contactHref} class="inline-flex items-center rounded-xl border border-white/20 bg-white/10 px-5 py-3 text-sm font-extrabold text-white backdrop-blur-sm transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-gray-900">
							Vyžiadať ponuku
						</a>
					</div>
				</div>
			</div>
			<p class="absolute bottom-3 right-4 z-10 text-right text-[0.68rem] text-white/75 sm:right-6 lg:right-8">
				<a href="https://commons.wikimedia.org/wiki/File:Vario_LF2%2B_Ko%C5%A1ice_%C4%8D801.JPG" class="underline underline-offset-2 hover:text-white">Foto: Adehertogh / Wikimedia Commons</a>,
				<a href="https://creativecommons.org/licenses/by-sa/4.0/" class="underline underline-offset-2 hover:text-white">CC BY-SA 4.0</a>
			</p>
		</section>

		<div class="bg-brand">
			<div class="mx-auto grid max-w-7xl grid-cols-1 divide-y divide-white/20 px-4 sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-6 lg:px-8">
				{["Košice", "Ceny bez DPH", "Kompletný servis"].map((fact) => (
					<div class="px-4 py-5 text-center text-lg font-black text-white">{fact}</div>
				))}
			</div>
		</div>

		<div id="o-mhd" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
				<div class="flex flex-col gap-10 lg:col-span-2">
					<section>
						<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em] text-brand">O type nositeľa</p>
						<h2 class="mb-5 text-[1.65rem] font-black leading-tight text-bb-ink">Reklama v košickej MHD — prenájom plôch na vozidlách a v uliciach</h2>
						<div class="flex flex-col gap-4">
							<p class="text-[0.98rem] leading-relaxed text-gray-600">Reklama v košickej MHD spája mobilné plochy na autobusoch a električkách s nosičmi na verejnom osvetlení.</p>
							<p class="text-[0.98rem] leading-relaxed text-gray-600">Kampaň sa môže pohybovať naprieč mestom alebo zostať viditeľná na vybraných uliciach. Zvoliť si môžete celoplošný polep, menší formát na vozidle, smerovú tabuľu alebo vlajku.</p>
							<p class="text-[0.98rem] leading-relaxed text-gray-600">Pripravíme kombináciu plôch a dĺžku prenájmu podľa cieľa, lokality a rozsahu kampane.</p>
						</div>
					</section>

					<section>
						<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em] text-brand">Prečo si vybrať tento formát</p>
						<h3 class="mb-5 text-[1.35rem] font-black text-bb-ink">Kľúčové výhody</h3>
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
							{MHD_ADVANTAGES.map((advantage) => (
								<article class="flex gap-4 rounded-2xl border border-gray-100 bg-gray-50 p-4">
									<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand/10 text-brand">
										<Icon name={advantage.icon} width="18" height="18" />
									</div>
									<div>
										<h4 class="text-[0.96rem] font-extrabold text-bb-ink">{advantage.title}</h4>
										<p class="mt-1 text-sm leading-relaxed text-gray-500">{advantage.desc}</p>
									</div>
								</article>
							))}
						</div>
					</section>

					<section id="ponuka-mhd" class="scroll-mt-40">
						<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em] text-brand">Dostupné plochy</p>
						<h3 class="mb-4 text-[1.35rem] font-black text-bb-ink">Ponuka MHD reklamy</h3>
						<div class="flex flex-col gap-3">
							{MHD_SECTIONS.map((item, index) => (
								<a href={item.href} class="group flex items-center gap-4 rounded-xl border border-gray-100 bg-white p-4 transition-shadow hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2">
									<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand text-sm font-black text-white">{String(index + 1).padStart(2, "0")}</div>
									<div class="min-w-0 flex-1">
										<h4 class="text-[0.96rem] font-extrabold text-bb-ink">{item.title}</h4>
										<p class="mt-0.5 text-sm text-gray-500">{item.desc}</p>
									</div>
									<span class="hidden shrink-0 rounded-full bg-brand/10 px-3 py-1 text-xs font-extrabold text-brand sm:inline-flex">{item.badge}</span>
									<Icon name="lucide:arrow-right" width="15" height="15" class="shrink-0 text-gray-400 transition-transform group-hover:translate-x-0.5" />
								</a>
							))}
						</div>
					</section>
				</div>

				<aside class="lg:col-span-1">
					<div class="lg:sticky lg:top-36">
						<section class="mb-4 overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
							<div class="flex items-center gap-3 bg-brand px-5 py-4 text-white">
								<Icon name="lucide:settings-2" width="18" height="18" />
								<h3 class="text-base font-extrabold">Technické parametre</h3>
							</div>
							<div class="divide-y divide-gray-50">
								{MHD_SPECS.map((spec, index) => (
									<div class:list={["flex items-start text-sm", index % 2 === 0 ? "bg-gray-50" : "bg-white"]}>
										<span class="w-1/2 shrink-0 px-4 py-2.5 text-gray-500">{spec.label}</span>
										<span class="w-1/2 px-4 py-2.5 font-bold text-gray-800">{spec.value}</span>
									</div>
								))}
							</div>
						</section>

						<section class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
							<h3 class="mb-1 text-base font-extrabold text-bb-ink">Záujem o reklamu v MHD?</h3>
							<p class="mb-4 text-sm leading-relaxed text-gray-500">Kontaktujte nás a pripravíme kombináciu plôch pre vašu kampaň v Košiciach.</p>
							<a href={`tel:${CONTACT_PHONE_TEL}`} class="mb-2 flex w-full items-center justify-center gap-2 rounded-xl bg-brand py-2.5 text-sm font-extrabold text-white transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2">
								<Icon name="lucide:phone" width="14" height="14" />
								{CONTACT_PHONE_DISPLAY}
							</a>
							<a href={contactHref} class="flex w-full items-center justify-center gap-2 rounded-xl border border-gray-200 py-2.5 text-sm font-extrabold text-gray-700 transition-colors hover:bg-gray-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2">
								Vyžiadať ponuku
								<Icon name="lucide:arrow-right" width="14" height="14" />
							</a>
						</section>
					</div>
				</aside>
			</div>
		</div>

		<nav data-mhd-catalog-nav data-visible="false" aria-hidden="true" aria-label="Kategórie reklamy v MHD" class="pointer-events-none fixed inset-x-0 top-[121px] z-30 border-y border-white/10 bg-bb-control/95 opacity-0 shadow-md backdrop-blur transition-opacity duration-200">
			<div class="mx-auto flex max-w-7xl gap-2 overflow-x-auto px-4 py-3 sm:px-6 lg:px-8">
				<a href="#autobusy" class="shrink-0 rounded-full border border-white/10 bg-white/10 px-4 py-2 text-sm font-extrabold text-white transition-colors hover:bg-white hover:text-bb-control focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-bb-control">Autobusy</a>
				<a href="#elektricky" class="shrink-0 rounded-full border border-white/10 bg-white/10 px-4 py-2 text-sm font-extrabold text-white transition-colors hover:bg-white hover:text-bb-control focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-bb-control">Električky</a>
				<a href="#verejne-osvetlenie" class="shrink-0 rounded-full border border-white/10 bg-white/10 px-4 py-2 text-sm font-extrabold text-white transition-colors hover:bg-white hover:text-bb-control focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-bb-control">Verejné osvetlenie</a>
			</div>
		</nav>

		<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
			<section id="autobusy" class="scroll-mt-44">
				<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em] text-brand">Reklama na vozidlách</p>
				<h2 class="text-[2rem] font-black text-bb-ink">Autobusy</h2>
				<p class="mt-3 max-w-3xl leading-relaxed text-gray-600">Vyberte si z jedenástich formátov od celoplošného polepu po menšie bočné a zadné reklamné plochy.</p>
				<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
					{BUS_OFFERS.map((offer) => <MhdOfferCard offer={offer} />)}
				</div>
			</section>

			<section id="elektricky" class="scroll-mt-44 pt-20">
				<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em] text-brand">Reklama na vozidlách</p>
				<h2 class="text-[2rem] font-black text-bb-ink">Električky</h2>
				<p class="mt-3 max-w-3xl leading-relaxed text-gray-600">Výrazné plochy na električkách pre kampane, ktoré sa pohybujú naprieč Košicami.</p>
				<div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
					{TRAM_OFFERS.map((offer) => <MhdOfferCard offer={offer} />)}
				</div>
			</section>

			<section id="verejne-osvetlenie" class="scroll-mt-44 pt-20">
				<header>
					<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em] text-brand">O type nositeľa</p>
					<h2 class="mb-5 text-[1.65rem] font-black leading-tight text-bb-ink">Verejné osvetlenie</h2>
					<p class="max-w-2xl text-[0.98rem] leading-relaxed text-gray-600">Smerové tabule a vlajky dopĺňajú ponuku reklamných plôch v košických uliciach.</p>
				</header>

				<div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1.65fr)_minmax(18rem,0.85fr)] lg:items-start">
					<div data-lighting-prices class="flex min-w-0 flex-col gap-6">
						<article class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
							<div class="bg-brand/10 px-5 py-4 text-brand sm:px-6">
								<h3 class="text-lg font-black">Smerové informačno-navádzacie tabule (SIT)</h3>
							</div>
							<div class="overflow-x-auto">
								<table class="w-full min-w-96 text-left text-sm" aria-label="Cenník smerových informačno-navádzacích tabúľ">
									<thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
										<tr><th scope="col" class="px-5 py-3">Typ</th><th scope="col" class="px-5 py-3">Obdobie</th><th scope="col" class="px-5 py-3 text-right">Cena prenájmu / mesiac</th></tr>
									</thead>
									<tbody class="divide-y divide-gray-100">
										{SIT_RENTALS.map((offer) => (
											<tr><th scope="row" class="px-5 py-3 font-bold text-bb-ink">{offer.title}</th><td class="px-5 py-3 text-gray-600">{offer.period}</td><td class="whitespace-nowrap px-5 py-3 text-right font-black">{formatEuro(discountPrice(offer.sourcePrice))}</td></tr>
										))}
									</tbody>
								</table>
							</div>
						</article>

						<article class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
							<div class="bg-brand/10 px-5 py-4 text-brand sm:px-6">
								<h3 class="text-lg font-black">VLAJKA na stĺpoch verejného osvetlenia</h3>
							</div>
							<div class="overflow-x-auto">
								<table class="w-full min-w-96 text-left text-sm" aria-label="Cenník vlajok na stĺpoch verejného osvetlenia">
									<thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
										<tr><th scope="col" class="px-5 py-3">Typ</th><th scope="col" class="px-5 py-3">Obdobie</th><th scope="col" class="px-5 py-3 text-right">Cena prenájmu</th></tr>
									</thead>
									<tbody class="divide-y divide-gray-100">
										{FLAG_RENTALS.map((offer) => (
											<tr><th scope="row" class="px-5 py-3 font-bold text-bb-ink">{offer.title}</th><td class="px-5 py-3 text-gray-600">{offer.period}</td><td class="whitespace-nowrap px-5 py-3 text-right font-black">{formatEuro(discountPrice(offer.sourcePrice))}</td></tr>
										))}
									</tbody>
								</table>
							</div>
						</article>

					</div>

					<aside data-street-categories class="flex min-h-[32rem] flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm lg:min-h-0" aria-labelledby="street-category-title">
						<div class="flex items-center gap-3 bg-brand/10 px-5 py-4 text-brand">
							<Icon name="lucide:map" width="18" height="18" />
							<h3 id="street-category-title" class="text-base font-extrabold">Kategória ulíc</h3>
						</div>

						<div class="flex gap-2 border-b border-gray-100 bg-gray-50 p-3" role="tablist" aria-label="Kategória ulíc">
							{STREET_CATEGORIES.map((category, index) => (
								<button
									type="button"
									class="street-category-tab rounded-xl px-3 py-3 text-left text-sm font-black transition-shadow hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gray-400 focus-visible:ring-offset-2"
									role="tab"
									id={`street-tab-${category.code}`}
									aria-controls={`street-panel-${category.code}`}
									aria-selected={index === 0 ? "true" : "false"}
									data-category-tab={category.code}
								>
									<span class="block text-lg">{category.code}</span>
									<span class="category-tab-label mt-0.5 block whitespace-nowrap text-[0.68rem] font-bold opacity-70">{category.items.length} {category.code === "C" ? "skupiny" : "ulíc"}</span>
								</button>
							))}
						</div>

						<div class="min-h-0 flex-1 bg-gray-50 p-3 sm:p-4">
							{STREET_CATEGORIES.map((category, index) => (
								<div
									class="h-full"
									role="tabpanel"
									id={`street-panel-${category.code}`}
									aria-labelledby={`street-tab-${category.code}`}
									data-category-panel={category.code}
									hidden={index !== 0}
								>
									<ul class="street-category-list grid max-h-[30rem] auto-rows-max content-start grid-cols-1 gap-2 overflow-y-auto pr-1 sm:grid-cols-2 lg:h-full lg:max-h-none lg:grid-cols-1" aria-label={`Ulice kategórie ${category.code}`}>
										{category.items.map((item) => <li class="rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-sm font-semibold text-gray-700 shadow-xs">{item}</li>)}
									</ul>
								</div>
							))}
						</div>
					</aside>
				</div>
			</section>
		</div>

		<section class="bg-bb-ink py-14">
			<div class="mx-auto max-w-4xl px-4 text-center sm:px-6">
				<h2 class="mb-3 text-[1.8rem] font-black text-white">Máte záujem o reklamu v košickej MHD?</h2>
				<p class="mb-8 text-base text-white/60">Napíšte nám alebo zavolajte. Pripravíme ponuku podľa formátu a dĺžky kampane.</p>
				<div class="flex flex-wrap justify-center gap-3">
					<a href={contactHref} class="inline-flex items-center gap-2 rounded-xl bg-brand px-6 py-3 text-sm font-extrabold text-white transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-bb-ink">
						Vyžiadať ponuku
						<Icon name="lucide:arrow-right" width="15" height="15" />
					</a>
					<a href={`tel:${CONTACT_PHONE_TEL}`} class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-6 py-3 text-sm font-extrabold text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-bb-ink">
						<Icon name="lucide:phone" width="14" height="14" />
						{CONTACT_PHONE_DISPLAY}
					</a>
					<a href={`mailto:${CONTACT_EMAIL}`} class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-6 py-3 text-sm font-extrabold text-white transition-colors hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-bb-ink">
						<Icon name="lucide:mail" width="14" height="14" />
						{CONTACT_EMAIL}
					</a>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	[data-mhd-catalog-nav][data-visible="true"] {
		pointer-events: auto;
		opacity: 1;
	}

	.street-category-tab {
		min-width: 0;
		flex: 1 1 0%;
		background: #e5e7eb;
		color: #374151;
		transition: flex-grow 220ms ease, background-color 180ms ease, color 180ms ease, box-shadow 180ms ease;
	}

	.street-category-tab[aria-selected="true"] {
		flex-grow: 2.5;
		background: #fff;
		color: #132033;
		box-shadow: inset 0 0 0 1px #d1d5db, 0 1px 2px rgb(0 0 0 / 6%);
	}

	.street-category-tab:hover {
		box-shadow: 0 4px 6px -1px rgb(0 0 0 / 10%), 0 2px 4px -2px rgb(0 0 0 / 10%);
	}

	.street-category-tab:not([aria-selected="true"]) .category-tab-label {
		max-height: 0;
		margin-top: 0;
		opacity: 0;
		overflow: hidden;
	}

	.street-category-list {
		scrollbar-color: #c5c7cb transparent;
		scrollbar-width: thin;
	}

	@media (prefers-reduced-motion: reduce) {
		.street-category-tab {
			transition: none;
		}
	}
</style>

<script>
	const catalogNav = document.querySelector<HTMLElement>("[data-mhd-catalog-nav]");
	const overviewSection = document.querySelector<HTMLElement>("#o-mhd");
	const catalogNavLinks = Array.from(catalogNav?.querySelectorAll<HTMLAnchorElement>("a") ?? []);

	const syncCatalogNav = () => {
		if (!catalogNav || !overviewSection) return;
		const isVisible = overviewSection.getBoundingClientRect().bottom <= 184;
		catalogNav.dataset.visible = String(isVisible);
		catalogNav.setAttribute("aria-hidden", String(!isVisible));
		catalogNavLinks.forEach((link) => isVisible ? link.removeAttribute("tabindex") : link.setAttribute("tabindex", "-1"));
	};

	window.addEventListener("scroll", syncCatalogNav, { passive: true });
	window.addEventListener("resize", syncCatalogNav);
	requestAnimationFrame(syncCatalogNav);

	const categoryContainers = document.querySelectorAll<HTMLElement>("[data-street-categories]");

	categoryContainers.forEach((container) => {
		const tabs = Array.from(container.querySelectorAll<HTMLButtonElement>("[data-category-tab]"));
		const panels = Array.from(container.querySelectorAll<HTMLElement>("[data-category-panel]"));
		const pricingColumn = container.parentElement?.querySelector<HTMLElement>("[data-lighting-prices]");
		const desktopLayout = window.matchMedia("(min-width: 1024px)");

		const syncPanelHeight = () => {
			if (!pricingColumn) return;
			if (desktopLayout.matches) container.style.height = `${pricingColumn.getBoundingClientRect().height}px`;
			else container.style.removeProperty("height");
		};

		if (pricingColumn) {
			new ResizeObserver(syncPanelHeight).observe(pricingColumn);
			desktopLayout.addEventListener("change", syncPanelHeight);
			syncPanelHeight();
		}

		const activateCategory = (code: string) => {
			tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.categoryTab === code)));
			panels.forEach((panel) => {
				const isActive = panel.dataset.categoryPanel === code;
				panel.hidden = !isActive;
				if (isActive) panel.querySelector<HTMLElement>(".street-category-list")?.scrollTo({ top: 0 });
			});
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener("click", () => activateCategory(tab.dataset.categoryTab ?? "A"));
			tab.addEventListener("keydown", (event) => {
				let nextIndex = index;
				if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
				else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
				else if (event.key === "Home") nextIndex = 0;
				else if (event.key === "End") nextIndex = tabs.length - 1;
				else return;

				event.preventDefault();
				const nextTab = tabs[nextIndex];
				nextTab?.focus();
				activateCategory(nextTab?.dataset.categoryTab ?? "A");
			});
		});
	});
</script>
