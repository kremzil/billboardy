---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/layout.astro";
import MapSection from "../../components/MapSection.astro";
import { AD_TYPE_SLUGS, SLUG_TO_TYPE, TYPE_CONTENT, type AdTypeSlug } from "../../data/adTypes";

export function getStaticPaths() {
	return AD_TYPE_SLUGS.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as AdTypeSlug;
const content = TYPE_CONTENT[slug];
const typeLabel = SLUG_TO_TYPE[slug];
const basePath = import.meta.env.BASE_URL;
const homeHref = basePath;
const typeHref = (item: AdTypeSlug) => `${basePath}typ/${item}/`;
const otherTypes = AD_TYPE_SLUGS.filter((item) => item !== slug);
const seoDescription = `${content.subtitle}. Pozrite si dostupné plochy na interaktívnej mape a vyberte lokalitu pre vašu outdoor kampaň.`;
const ogImage = content.heroImg.replace("../../", "/");
const stats = [
	{ label: "Dostupné plochy", value: "Mapa" },
	{ label: "Mestá na Slovensku", value: "12+" },
	...(content.minPrice ? [{ label: "Cena od", value: `€${content.minPrice}` }] : []),
	{ label: "Spustenie kampane", value: "48 h" },
];
---

<Layout title={content.seoTitle} description={seoDescription} canonicalPath={`typ/${slug}/`} image={ogImage} imageAlt={`${content.title} reklamná plocha`}>
	<div class="min-h-screen bg-white" style={`--type-accent:${content.accentColor}`}>
		<div class="sticky top-16 z-40 border-b border-gray-100 bg-white/95 shadow-sm backdrop-blur">
			<div class="mx-auto flex h-14 max-w-7xl items-center gap-3 px-4 text-sm sm:px-6 lg:px-8">
				<a href={homeHref} class="flex items-center gap-1.5 font-bold text-gray-500 transition-colors hover:text-gray-900">
					<Icon name="lucide:arrow-left" width="15" height="15" />
					Späť
				</a>
				<span class="text-gray-300">/</span>
				<span class="text-xs font-semibold text-gray-400">Typy nosičov</span>
				<span class="text-gray-300">/</span>
				<span class="font-extrabold text-bb-ink">{content.title}</span>
			</div>
		</div>

		<section class="relative min-h-120 overflow-hidden">
			<img src={content.heroImg} alt={content.title} class="absolute inset-0 h-full w-full object-cover" />
			<div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(21,23,25,0.88)_35%,rgba(21,23,25,0.28))]"></div>
			<div class="relative mx-auto flex min-h-120 max-w-7xl items-center px-4 py-16 sm:px-6 lg:px-8">
				<div class="max-w-2xl">
					<span class="mb-4 inline-flex rounded-full px-3 py-1 text-xs font-extrabold text-white" style={`background:${content.accentColor}`}>
						Typ nositeľa
					</span>
					<h1 class="text-[clamp(2.4rem,5vw,3.75rem)] font-black leading-[1.04] text-white">{content.title}</h1>
					<p class="mt-4 max-w-lg text-[1.05rem] leading-relaxed text-gray-200">{content.subtitle}</p>
					{content.minPrice && (
						<div class="mt-6 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 backdrop-blur-sm">
							<span class="text-lg font-black text-bb-yellow">od €{content.minPrice}</span>
							<span class="text-sm text-white/75">/ kampaň</span>
						</div>
					)}
					<div class="mt-7 flex flex-wrap gap-3">
						<a href="#plochy" class="inline-flex items-center gap-2 rounded-xl bg-brand px-5 py-3 text-sm font-extrabold text-white transition-opacity hover:opacity-90">
							Pozrieť dostupné plochy
							<Icon name="lucide:arrow-right" width="15" height="15" />
						</a>
						<a href="#o-nosici" class="inline-flex items-center rounded-xl border border-white/20 bg-white/10 px-5 py-3 text-sm font-extrabold text-white backdrop-blur-sm transition-colors hover:bg-white/20">
							Viac o formáte
						</a>
					</div>
				</div>
			</div>
		</section>

		<div style={`background:${content.accentColor}`}>
			<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-2 divide-x divide-white/20 sm:grid-cols-4">
					{stats.map((item) => (
						<div class="px-4 py-4 text-center text-white sm:px-8">
							<div class="text-2xl font-black leading-none">{item.value}</div>
							<div class="mt-1 text-xs text-white/75">{item.label}</div>
						</div>
					))}
				</div>
			</div>
		</div>

		<div id="o-nosici" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-3">
				<div class="flex flex-col gap-10 lg:col-span-2">
					<section>
						<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em]" style={`color:${content.accentColor}`}>O type nositeľa</p>
						<h2 class="mb-5 text-[1.65rem] font-black leading-tight text-bb-ink">{content.seoTitle}</h2>
						<div class="flex flex-col gap-4">
							{content.seoText.map((paragraph) => (
								<p class="text-[0.98rem] leading-relaxed text-gray-600">{paragraph}</p>
							))}
						</div>
					</section>

					<section>
						<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em]" style={`color:${content.accentColor}`}>Prečo si vybrať tento formát</p>
						<h3 class="mb-5 text-[1.35rem] font-black text-bb-ink">Kľúčové výhody</h3>
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
							{content.advantages.map((advantage) => (
								<article class="flex gap-4 rounded-2xl border border-gray-100 bg-gray-50 p-4">
									<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl" style={`background:${content.accentColor}18`}>
										<Icon name={advantage.icon} width="18" height="18" style={`color:${content.accentColor}`} />
									</div>
									<div>
										<h4 class="text-[0.96rem] font-extrabold text-bb-ink">{advantage.title}</h4>
										<p class="mt-1 text-sm leading-relaxed text-gray-500">{advantage.desc}</p>
									</div>
								</article>
							))}
						</div>
					</section>

					<section>
						<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em]" style={`color:${content.accentColor}`}>Dostupné varianty</p>
						<h3 class="mb-4 text-[1.35rem] font-black text-bb-ink">Formáty</h3>
						<div class="flex flex-col gap-3">
							{content.formats.map((format, index) => (
								<article class="flex items-center gap-4 rounded-xl border border-gray-100 bg-white p-4 transition-shadow hover:shadow-md">
									<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-sm font-black text-white" style={`background:${content.accentColor}`}>
										{String(index + 1).padStart(2, "0")}
									</div>
									<div class="min-w-0 flex-1">
										<h4 class="text-[0.96rem] font-extrabold text-bb-ink">{format.label}</h4>
										<p class="mt-0.5 text-sm text-gray-500">{format.desc}</p>
									</div>
									<span class="shrink-0 rounded-full px-3 py-1 text-xs font-extrabold" style={`background:${content.accentColor}15;color:${content.accentColor}`}>
										{format.size}
									</span>
								</article>
							))}
						</div>
					</section>

					<section>
						<p class="mb-2 text-xs font-extrabold uppercase tracking-[0.08em]" style={`color:${content.accentColor}`}>Kto to využíva</p>
						<h3 class="mb-4 text-[1.35rem] font-black text-bb-ink">Typické použitie</h3>
						<div class="flex flex-wrap gap-2">
							{content.useCases.map((item) => (
								<span class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-3 py-1.5 text-sm font-bold text-gray-700">
									<Icon name="lucide:check-circle" width="13" height="13" style={`color:${content.accentColor}`} />
									{item}
								</span>
							))}
						</div>
					</section>
				</div>

				<aside class="lg:col-span-1">
					<div class="sticky top-36">
						<section class="mb-4 overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
							<div class="flex items-center gap-3 px-5 py-4 text-white" style={`background:${content.accentColor}`}>
								<Icon name="lucide:ruler" width="18" height="18" />
								<h3 class="text-base font-extrabold">Technické parametre</h3>
							</div>
							<div class="divide-y divide-gray-50">
								{content.specs.map((spec, index) => (
									<div class:list={["flex items-start text-sm", index % 2 === 0 ? "bg-gray-50" : "bg-white"]}>
										<span class="w-1/2 shrink-0 px-4 py-2.5 text-gray-500">{spec.label}</span>
										<span class="w-1/2 px-4 py-2.5 font-bold text-gray-800">{spec.value}</span>
									</div>
								))}
							</div>
						</section>

						<section class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm">
							<h3 class="mb-1 text-base font-extrabold text-bb-ink">Záujem o {content.title}?</h3>
							<p class="mb-4 text-sm leading-relaxed text-gray-500">Kontaktujte nás a navrhneme najvhodnejšiu polohu pre vašu kampaň.</p>
							<a href="tel:+421917930494" class="mb-2 flex w-full items-center justify-center gap-2 rounded-xl bg-brand py-2.5 text-sm font-extrabold text-white transition-opacity hover:opacity-90">
								<Icon name="lucide:phone" width="14" height="14" />
								+421 917 930 494
							</a>
							<a href="#plochy" class="flex w-full items-center justify-center gap-2 rounded-xl border border-gray-200 py-2.5 text-sm font-extrabold text-gray-700 transition-colors hover:bg-gray-50">
								Pozrieť plochy na mape
								<Icon name="lucide:arrow-right" width="14" height="14" />
							</a>

							<div class="mt-5 border-t border-gray-100 pt-4">
								<p class="mb-3 text-xs font-extrabold uppercase tracking-[0.05em] text-gray-400">Iné typy nosičov</p>
								<div class="flex flex-col gap-1.5">
									{otherTypes.map((item) => (
										<a href={typeHref(item)} class="flex items-center justify-between rounded-lg px-2 py-1.5 text-sm font-bold text-gray-600 transition-colors hover:bg-gray-50 hover:text-gray-900">
											{SLUG_TO_TYPE[item]}
											<Icon name="lucide:arrow-right" width="13" height="13" class="text-gray-400" />
										</a>
									))}
								</div>
							</div>
						</section>
					</div>
				</aside>
			</div>
		</div>

		<MapSection
			id="plochy"
			title={`Dostupné plochy · ${content.title}`}
			summary={`Načítavam plochy pre ${typeLabel}...`}
			initialMediaType={content.mapMediaType}
			filterLabel={typeLabel}
			lockMediaType
			hideMediaFilters
		/>

		<section class="bg-bb-ink py-14">
			<div class="mx-auto max-w-4xl px-4 text-center">
				<h2 class="mb-3 text-[1.8rem] font-black text-white">Chcete kampaň na {content.title.toLowerCase()}?</h2>
				<p class="mb-8 text-base text-white/60">Zavolajte nám alebo si priamo vyberte plochu na mape. Prvá konzultácia je zdarma.</p>
				<div class="flex flex-wrap justify-center gap-3">
					<a href="#plochy" class="inline-flex items-center gap-2 rounded-xl bg-brand px-6 py-3 text-sm font-extrabold text-white transition-opacity hover:opacity-90">
						Vybrať plochu
						<Icon name="lucide:arrow-right" width="15" height="15" />
					</a>
					<a href="tel:+421917930494" class="inline-flex items-center gap-2 rounded-xl border border-white/20 bg-white/10 px-6 py-3 text-sm font-extrabold text-white transition-colors hover:bg-white/20">
						<Icon name="lucide:phone" width="14" height="14" />
						Zavolať
					</a>
				</div>
			</div>
		</section>
	</div>
</Layout>
