---
import { Icon } from 'astro-icon/components'
import { AD_TYPE_SLUGS, SLUG_TO_TYPE } from '../data/adTypes'
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_TEL } from '../data/site'

const basePath = import.meta.env.BASE_URL;
const areaLinks = AD_TYPE_SLUGS.map((slug) => ({
	label: SLUG_TO_TYPE[slug],
	href: `${basePath}typ/${slug}/`,
}));
const links = [
	{label: 'ceny', href: `${basePath}#ceny`},
	{label: 'mapa', href: `${basePath}#mapa`},
	{label: 'ako to funguje?', href: `${basePath}#ako`},
	{label: 'kontakt', href: `${basePath}kontakt`},
]

const stripBasePath = (path: string) => {
	const normalizedBase = basePath.endsWith("/") ? basePath : `${basePath}/`;

	if (normalizedBase !== "/" && path.startsWith(normalizedBase)) {
		return `/${path.slice(normalizedBase.length)}`;
	}

	return path;
};
const normalizeComparablePath = (path: string) => {
	const normalizedPath = stripBasePath(path);
	return normalizedPath.endsWith("/") ? normalizedPath : `${normalizedPath}/`;
};
const currentPath = normalizeComparablePath(Astro.url.pathname);
const normalizePath = (href: string) => {
	const path = new URL(href, Astro.site ?? Astro.url).pathname;
	return normalizeComparablePath(path);
};
const isTypePage = currentPath.startsWith("/typ/");
const isHashLink = (href: string) => href.includes("#");
const isActivePath = (href: string) => !isHashLink(href) && normalizePath(href) === currentPath;
---
 
 <header class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 shadow-sm" data-nav-root data-base-path={basePath}>
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex items-center justify-between h-16">
				<div class="flex items-center">
					<a href={basePath} class="text-xl font-bold text-gray-800"><span class="text-brand">B</span>illboardy.sk</a>

				</div>

				<nav class="hidden md:flex items-center gap-8">
					<div class="relative group">
						<button
							type="button"
							class:list={[
								"flex items-center gap-1 text-gray-800 hover:text-brand transition-colors duration-200",
								isTypePage && "font-bold text-brand",
							]}
							aria-haspopup="true"
						>
							reklamné plochy
							<Icon name="lucide:chevron-down" width="14" height="14" />
						</button>
						<div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-focus-within:visible group-focus-within:opacity-100 group-focus-within:translate-y-0 absolute left-0 top-full mt-3 w-56 rounded-xl border border-gray-100 bg-white p-2 shadow-xl transition-all duration-150">
							{areaLinks.map(link => (
								<a
									href={link.href}
									class:list={[
										"block rounded-lg px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-brand transition-colors duration-150",
										isActivePath(link.href) ? "font-bold text-brand" : "font-semibold",
									]}
									aria-current={isActivePath(link.href) ? "page" : undefined}
								>
									{link.label}
								</a>
							))}
						</div>
					</div>
					{links.map(link => (
						<a
							href={link.href}
							class:list={[
								"text-gray-800 hover:text-brand transition-colors duration-200",
								isActivePath(link.href) ? "font-bold text-brand" : "font-normal",
							]}
							data-nav-link
							aria-current={isActivePath(link.href) ? "page" : undefined}
						>{link.label}</a>
					))}
				</nav>
				<div class="hidden md:flex items-center gap-3">
					<a href={`tel:${CONTACT_PHONE_TEL}`} class="flex items-center gap-1 text-gray-800 hover:text-brand transition-colors duration-200">
						<Icon name="lucide:phone" width="15" height="15" />
						{CONTACT_PHONE_DISPLAY}
					</a>
					<a href={`${basePath}#mapa`} class="bg-brand text-white px-4 py-2 rounded-lg text-sm font-medium 
												transition-colors duration-200 hover:opacity-85">
												Prenajať plochu
					</a>
				</div>
			
<!-- mobile toggle -->

				<button
					type="button"
					class="md:hidden p-2 rounded-lg text-gray-800"
					data-menu-toggle
					aria-expanded="false"
					aria-label="Otvoriť menu"
				>
					<Icon name="lucide:menu" width="20" height="20" data-icon-menu />
					<Icon name="lucide:x" width="20" height="20" class="hidden" data-icon-close />
				</button>

			</div>
		</div>

<!-- mobile menu -->
		<div class="hidden md:hidden border-t border-gray-100 bg-white px-4 py-4 flex-col gap-1" data-mobile-menu>
			<div class="border-b border-gray-100 pb-3 mb-2">
				<p class="px-1 pb-1 text-xs font-bold uppercase tracking-wide text-gray-400">Reklamné plochy</p>
				{areaLinks.map(link => (
					<a
						href={link.href}
						class:list={[
							"block rounded-lg px-1 py-2 text-sm text-gray-700 hover:text-brand transition-colors duration-200",
							isActivePath(link.href) ? "font-bold text-brand" : "font-medium",
						]}
						aria-current={isActivePath(link.href) ? "page" : undefined}
						data-menu-link
					>{link.label}</a>
				))}
			</div>
			{links.map(link => (
				<a
					href={link.href}
					class:list={[
						"text-gray-700 py-2 text-sm hover:text-brand transition-colors duration-200",
						isActivePath(link.href) ? "font-bold text-brand" : "font-medium",
					]}
					data-nav-link
					aria-current={isActivePath(link.href) ? "page" : undefined}
					data-menu-link
				>{link.label}</a>
			))}
			<a
				href={`${basePath}#kontakt`}
				class="bg-brand text-white px-4 py-2.5 rounded-lg text-sm font-semibold text-center mt-2 hover:opacity-90 transition-opacity duration-200"
			>
				Prenajať plochu
			</a>
		</div>
	</header>

<script>
	const toggle = document.querySelector('[data-menu-toggle]');
	const menuIcon = document.querySelector('[data-icon-menu]');
	const closeIcon = document.querySelector('[data-icon-close]');
	const mobileMenu = document.querySelector('[data-mobile-menu]');
	const menuLinks = document.querySelectorAll('[data-menu-link]');
	const navRoot = document.querySelector('[data-nav-root]');
	const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
	const navBasePath = navRoot?.getAttribute('data-base-path') ?? '/';

	function normalizeNavPath(path: string) {
		const normalizedBase = navBasePath.endsWith('/') ? navBasePath : `${navBasePath}/`;
		const pathWithoutBase = normalizedBase !== '/' && path.startsWith(normalizedBase)
			? `/${path.slice(normalizedBase.length)}`
			: path;

		return pathWithoutBase.endsWith('/') ? pathWithoutBase : `${pathWithoutBase}/`;
	}

	function updateActiveNavLink() {
		const currentPath = normalizeNavPath(window.location.pathname);
		const currentHash = window.location.hash;

		navLinks.forEach((link) => {
			const linkUrl = new URL(link.href);
			const linkPath = normalizeNavPath(linkUrl.pathname);
			const linkHash = linkUrl.hash;
			const isMobileLink = link.closest('[data-mobile-menu]') !== null;
			const isActive = linkHash
				? linkPath === currentPath && linkHash === currentHash
				: linkPath === currentPath;

			link.classList.toggle('font-bold', isActive);
			link.classList.toggle('font-normal', !isActive && !isMobileLink);
			link.classList.toggle('font-medium', !isActive && isMobileLink);
			link.classList.toggle('text-brand', isActive);
			if (isActive) {
				link.setAttribute('aria-current', 'page');
			} else {
				link.removeAttribute('aria-current');
			}
		});
	}

	function closeMenu() {
		toggle?.setAttribute('aria-expanded', 'false');
		toggle?.setAttribute('aria-label', 'Otvoriť menu');
		menuIcon?.classList.remove('hidden');
		closeIcon?.classList.add('hidden');
		mobileMenu?.classList.remove('flex');
		mobileMenu?.classList.add('hidden');
	}

	toggle?.addEventListener('click', () => {
		const isOpen = toggle.getAttribute('aria-expanded') === 'true';
		const nextOpen = !isOpen;

		toggle.setAttribute('aria-expanded', String(nextOpen));
		toggle.setAttribute('aria-label', nextOpen ? 'Zavrieť menu' : 'Otvoriť menu');
		menuIcon?.classList.toggle('hidden', nextOpen);
		closeIcon?.classList.toggle('hidden', !nextOpen);
		if (nextOpen) {
			mobileMenu?.classList.remove('hidden');
			mobileMenu?.classList.add('flex');
		} else {
			mobileMenu?.classList.remove('flex');
			mobileMenu?.classList.add('hidden');
		}
	});

	// zatvor menu po kliknutí na odkaz
	menuLinks.forEach(link => link.addEventListener('click', closeMenu));
	updateActiveNavLink();
	window.addEventListener('hashchange', updateActiveNavLink);
	window.addEventListener('popstate', updateActiveNavLink);
</script>
