---
import { Icon } from 'astro-icon/components'

const BILLBOARD_IMG =
	"./assets/billboard.webp";
const BIGBOARD_IMG =
	"./assets/bigboard.webp";
const CLV_IMG =
	"./assets/clv.webp";

interface PricingPlan {
	name: string;
	size: string;
	price: string;
	period: string;
	popular: boolean;
	features: string[];
	image: string;
	location: string;
	typeSlug: string;
}

interface PricingBlock {
	title: string;
	subtitle: string;
	currency: string;
	plans: PricingPlan[];
	disclaimer: string;
}

const skPlans: PricingPlan[] = [
	{
		name: "Billboard",
		size: "510x240 cm",
		price: "79",
		period: "kalendarny mesiac",
		popular: true,
		image: BILLBOARD_IMG,
		location: "Bratislava - centrum",
		typeSlug: "billboard",
		features: ["Last minute od 79 EUR", "Tlac od 25 EUR", "Instalacia v cene"],
	},
	{
		name: "Bigboard",
		size: "960x360 cm",
		price: "599",
		period: "kalendarny mesiac",
		popular: false,
		image: BIGBOARD_IMG,
		location: "D1 - Senec, vyjazd 45",
		typeSlug: "bigboard",
		features: ["Last minute od 599 EUR", "Tlac od 329 EUR", "Instalacia od 300 EUR"],
	},
	{
		name: "CLV",
		size: "118x175 cm",
		price: "79",
		period: "14 dni",
		popular: true,
		image: CLV_IMG,
		location: "Banska Bystrica - centrum",
		typeSlug: "citylight",
		features: ["Last minute od 79 EUR", "Tlac od 14 EUR", "Instalacia v cene"],
	},
];

const czPlans: PricingPlan[] = [
	{
		name: "Billboard",
		size: "510x240 cm",
		price: "3 990",
		period: "kalendarny mesiac",
		popular: true,
		image: BILLBOARD_IMG,
		location: "Praha - centrum",
		typeSlug: "billboard",
		features: ["Last minute od 3 990 Kc", "Tlac od 799 Kc", "Instalacia v cene"],
	},
	{
		name: "Bigboard",
		size: "960x360 cm",
		price: "24 999",
		period: "kalendarny mesiac",
		popular: false,
		image: BIGBOARD_IMG,
		location: "Praha - D1 dialnica",
		typeSlug: "bigboard",
		features: ["Last minute od 24 999 Kc", "Tlac od 1 499 Kc", "Instalacia v cene"],
	},
	{
		name: "CLV",
		size: "118x175 cm",
		price: "5 000",
		period: "kalendarny mesiac",
		popular: true,
		image: CLV_IMG,
		location: "Brno - centrum",
		typeSlug: "citylight",
		features: ["Last minute od 4 999 Kc", "Tlac od 399 Kc", "Instalacia v cene"],
	},
];

const blocks: PricingBlock[] = [
	{
		title: "Cennik - Slovenska republika",
		subtitle:
			"Transparentne ceny bez skrytych poplatkov. Vyberte si typ plochy a ziskajte najlepsiu cenu.",
		currency: "EUR",
		plans: skPlans,
		disclaimer: "Cena tlace neobsahuje naklady na prepravu plagatu.",
	},
	{
		title: "Cennik - Ceska republika",
		subtitle:
			"Transparentne ceny bez skrytych poplatkov. Vyberte si typ plochy a ziskajte najlepsiu cenu.",
		currency: "Kc",
		plans: czPlans,
		disclaimer: "Cena tlace neobsahuje naklady na prepravu plagatu.",
	},
];

const basePath = import.meta.env.BASE_URL;
---

<section id="ceny" class="py-20 bg-white">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		{
			blocks.map((block) => (
				<div class="mb-16">
					<div class="mb-8">
						<p class="text-sm mb-2 font-bold uppercase  text-brand">
							Cennik
						</p>
						<h2 class="text-[2rem] font-extrabold text-bb-ink">{block.title}</h2>
						<p class="text-gray-500 mt-2 text-sm max-w-lg">{block.subtitle}</p>
					</div>

					<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
						{
							block.plans.map((plan) => (
								<article class="bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-xl transition-all duration-300 flex flex-col group">
									<div class="relative h-44 overflow-hidden">
										<img
											src={plan.image}
											alt={plan.name}
											loading="lazy"
											class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
										/>
										{
											plan.popular && (
												<span
													class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-xs font-bold bg-bb-yellow text-bb-ink"
												>
													POPULARNE
												</span>
											)
										}
									</div>

									<div class="px-5 pt-4 pb-3 border-b border-gray-100">
										<h3 class="mb-4 text-2xl font-black tracking-wide text-bb-ink">
											{plan.name}
										</h3>

							

										<div class="flex items-center gap-2 mb-3">
											<span class="bg-gray-100 text-gray-900 px-2 py-0.5 rounded text-xs font-semibold">
												<Icon name="lucide:ruler" width="16" height="16" class="inline text-gray-400" />
												{plan.size}
											</span>
										</div>

										<div class="flex items-end gap-1">
											<span class="text-gray-400 text-sm pb-1">od</span>
											<span class="text-[2.2rem] font-extrabold leading-none text-bb-ink">{plan.price}</span>
											<span class="text-sm font-bold pb-1">
												{block.currency}
											</span>
										</div>
										<p class="text-gray-400 mt-1 text-[0.78rem]">{plan.period}</p>
									</div>

									<div class="px-5 py-4 flex flex-col gap-2 flex-1">
										{
											plan.features.map((feature) => (
												<div class="flex items-center gap-1.5 text-xs text-gray-600">
													<Icon name="lucide:check-circle" width="13" height="13" class="shrink-0 text-bb-green" />
													{feature}
												</div>
											))
										}
									</div>

									<div class="px-5 pb-5 pt-2 border-t border-gray-100 flex flex-col gap-2">
										<a
											class="w-full py-2.5 rounded-xl text-white transition-all duration-200 hover:opacity-90 text-center font-bold text-[0.9rem] bg-brand"
											href={`${basePath}typ/${plan.typeSlug}/`}
										>
											Viac informácií
										</a>

										<p class="text-gray-400 text-center text-[0.68rem]">{block.disclaimer}</p>
									</div>
								</article>
							))
						}
					</div>
				</div>
			))
		}
	</div>
</section>
