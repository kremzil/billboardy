---
import { Icon } from 'astro-icon/components'

const basePath = import.meta.env.BASE_URL;

interface Banner {
    title: string;
    subtitle: string;
    image: string;
    link: string;
    alt: string;
}

const banners: Banner[] = [
    {
        title: 'Tlač billboardov',
        subtitle: 'Už od 15,99 EUR s DPH',
        image: 'https://www.billboardy.sk/wp-content/uploads/2025/05/cta_billboard-1.webp',
        link: `${basePath}typ/billboard/`,
        alt: 'Billboard image'
    },
    {
        title: 'Banner a mesh',
        subtitle: 'Len 7.99 EUR/m2 - vrátane očiek a DPH',
        image: 'https://www.billboardy.sk/wp-content/uploads/2025/05/cta_bannermesh-1.jpg',
        link: `${basePath}typ/plachta/`,
        alt: 'Banner image'
    }
];

const count = banners.length;
---

<div
    class="banner-slider relative left-1/2 -ml-[50vw] w-screen overflow-hidden"
    id="banner-slider"
>
    <!-- Track -->
    <div
        class="flex will-change-transform transition-transform duration-500 ease-in-out"
        id="slider-track"
        style={`width: ${count * 100}vw`}
    >
        {banners.map((banner) => (
            <div class="relative shrink-0 w-screen h-64 md:h-120">
                <img
                    src={banner.image}
                    alt={banner.alt}
                    class="absolute inset-0 w-full h-full object-cover"
                />
                <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/25 to-transparent" />
                <div class="absolute inset-0 flex items-end md:items-center">
                    <div class="w-full max-w-7xl mx-auto px-4 md:px-8 pb-8 md:pb-0 text-white">
                        <h2 class="mb-2 drop-shadow-lg text-2xl md:text-4xl font-bold">{banner.title}</h2>
                        <p class="mb-4 drop-shadow text-gray-200">{banner.subtitle}</p>
                        <a href={banner.link} class="btn max-w-30">Objednať</a>
                    </div>
                </div>
            </div>
        ))}
    </div>

    <!-- Prev button -->
    <button
        id="slider-prev"
        aria-label="Predchádzajúci"
        class="hidden md:flex absolute left-3 top-1/2 -translate-y-1/2 z-20 h-10 w-10 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur-sm transition hover:bg-white/40"
    >
        <Icon name="lucide:chevron-left" class="h-6 w-6" />
    </button>

    <!-- Next button -->
    <button
        id="slider-next"
        aria-label="Nasledujúci"
        class="hidden md:flex absolute right-3 top-1/2 -translate-y-1/2 z-20 h-10 w-10 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur-sm transition hover:bg-white/40"
    >
        <Icon name="lucide:chevron-right" class="h-6 w-6" />
    </button>

    <!-- Dots -->
    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex gap-2">
        {banners.map((_, i) => (
            <button
                class={`dot h-2 rounded-full bg-white transition-all duration-300 ${i === 0 ? 'w-6 opacity-100' : 'w-2 opacity-50'}`}
                data-index={String(i)}
                aria-label={`Slide ${i + 1}`}
            />
        ))}
    </div>
</div>

<script>
    const slider = document.getElementById('banner-slider')!;
    const track = document.getElementById('slider-track')!;
    const dots = Array.from(slider.querySelectorAll<HTMLElement>('.dot'));
    const realTotal = dots.length;

    // --- Infinite loop: clone first and last slides ---
    const realSlides = Array.from(track.children) as HTMLElement[];
    const firstClone = realSlides[0].cloneNode(true) as HTMLElement;
    const lastClone  = realSlides[realTotal - 1].cloneNode(true) as HTMLElement;
    track.appendChild(firstClone);
    track.insertBefore(lastClone, realSlides[0]);

    const slideCount = realTotal + 2; // includes clones
    track.style.width = `${slideCount * 100}vw`;

    let current = 1; // 0 = last clone, 1 = first real, ..., realTotal = last real, realTotal+1 = first clone
    let busy = false;
    let timer: ReturnType<typeof setInterval>;

    function setTransform(animated: boolean) {
        track.style.transition = animated ? 'transform 500ms ease-in-out' : 'none';
        track.style.transform = `translateX(-${current * (100 / slideCount)}%)`;
    }

    function realIndex() {
        return ((current - 1) % realTotal + realTotal) % realTotal;
    }

    function updateDots() {
        const ri = realIndex();
        dots.forEach((dot, i) => {
            dot.classList.toggle('w-6',        i === ri);
            dot.classList.toggle('opacity-100', i === ri);
            dot.classList.toggle('w-2',        i !== ri);
            dot.classList.toggle('opacity-50',  i !== ri);
        });
    }

    // After transition: silently jump from clone to real slide
    track.addEventListener('transitionend', () => {
        if (current === 0) {
            current = realTotal;
            setTransform(false);
        } else if (current === slideCount - 1) {
            current = 1;
            setTransform(false);
        }
        busy = false;
    });

    function goTo(index: number) {
        if (busy) return;
        busy = true;
        current = index;
        setTransform(true);
        updateDots();
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function startAuto() { timer = setInterval(next, 5000); }
    function stopAuto()  { clearInterval(timer); }

    // Init: jump to position 1 without animation
    setTransform(false);
    updateDots();

    document.getElementById('slider-next')!.addEventListener('click', () => { stopAuto(); next(); startAuto(); });
    document.getElementById('slider-prev')!.addEventListener('click', () => { stopAuto(); prev(); startAuto(); });

    dots.forEach((dot) => {
        dot.addEventListener('click', () => {
            stopAuto();
            // dot index maps to current = index + 1 (offset by lastClone prepend)
            goTo(Number(dot.dataset.index) + 1);
            startAuto();
        });
    });

    slider.addEventListener('mouseenter', stopAuto);
    slider.addEventListener('mouseleave', startAuto);

    // Touch / swipe
    let touchStartX = 0;
    slider.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
    slider.addEventListener('touchend', (e) => {
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 40) { stopAuto(); diff > 0 ? next() : prev(); startAuto(); }
    });

    startAuto();
</script>
