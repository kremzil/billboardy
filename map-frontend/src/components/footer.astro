---
import { Icon } from 'astro-icon/components'
import { AD_TYPE_SLUGS, SLUG_TO_TYPE } from '../data/adTypes'

const basePath = import.meta.env.BASE_URL;
const plochy = AD_TYPE_SLUGS.map((slug) => ({ label: SLUG_TO_TYPE[slug], href: `${basePath}typ/${slug}/` }));
const kraje = [
	{ value: '', label: 'Celé Slovensko' },
	{ value: 'bratislavsky', label: 'Bratislavský kraj' },
	{ value: 'trnavsky', label: 'Trnavský kraj' },
	{ value: 'trenciansky', label: 'Trenčiansky kraj' },
	{ value: 'nitriansky', label: 'Nitriansky kraj' },
	{ value: 'zilinsky', label: 'Žilinský kraj' },
	{ value: 'banskobystricky', label: 'Banskobystrický kraj' },
	{ value: 'presovsky', label: 'Prešovský kraj' },
	{ value: 'kosicky', label: 'Košický kraj' },
]

const social = [
	{ icon: 'lucide:facebook',  href: '#', label: 'Facebook'  },
	{ icon: 'lucide:instagram', href: '#', label: 'Instagram' },
	{ icon: 'lucide:linkedin',  href: '#', label: 'LinkedIn'  },
]
---

<footer id="kontakt" class="bg-bb-ink text-gray-300">

	<!-- main grid -->
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

			<!-- brand -->
			<div class="lg:col-span-1">
				<a href={basePath} class="text-white text-xl font-bold tracking-tight block mb-4">Billboardy.sk</a>
				<p class="text-gray-400 text-sm leading-relaxed mb-4">
					Prémiové reklamné plochy na Slovensku. Transparentné ceny, okamžité rezervovanie, profesionálna inštalácia.
				</p>
				<div class="flex gap-3">
					{social.map(s => (
						<a
							href={s.href}
							aria-label={s.label}
							class="social-btn w-9 h-9 rounded-lg flex items-center justify-center transition-colors duration-200"
						>
							<Icon name={s.icon} width="16" height="16" />
						</a>
					))}
				</div>
			</div>

			<!-- plochy -->
			<div>
				<h4 class="text-white font-bold text-[15px] mb-4">Plochy</h4>
				<ul class="flex flex-col gap-2.5">
					{plochy.map(item => (
						<li>
							<a href={item.href} class="text-gray-400 hover:text-white text-sm transition-colors duration-200">{item.label}</a>
						</li>
					))}
				</ul>
			</div>

			<!-- kraje -->
			<div>
				<h4 class="text-white font-bold text-[15px] mb-4">Kraje</h4>
				<ul class="flex flex-col gap-2.5">
					{kraje.map(item => (
						<li>
							<a
								href={item.value ? `${basePath}?region=${item.value}#mapa` : `${basePath}#mapa`}
								class="text-gray-400 hover:text-white text-sm transition-colors duration-200"
								data-footer-region={item.value}
							>
								{item.label}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- kontakt -->
			<div>
				<h4 class="text-white font-bold text-[15px] mb-4">Kontakt</h4>
				<ul class="flex flex-col gap-3">
					<li>
						<a href="tel:+421900000000" class="flex items-center gap-2.5 text-gray-400 hover:text-white text-sm transition-colors duration-200">
							<span class="contact-icon w-8 h-8 rounded-lg flex items-center justify-center shrink-0">
								<Icon name="lucide:phone" width="14" height="14" />
							</span>
							+421 900 000 000
						</a>
					</li>
					<li>
						<a href="mailto:info@billboardy.sk" class="flex items-center gap-2.5 text-gray-400 hover:text-white text-sm transition-colors duration-200">
							<span class="contact-icon w-8 h-8 rounded-lg flex items-center justify-center shrink-0">
								<Icon name="lucide:mail" width="14" height="14" />
							</span>
							info@billboardy.sk
						</a>
					</li>
					<li>
						<div class="flex items-start gap-2.5 text-gray-400 text-sm">
							<span class="contact-icon w-8 h-8 rounded-lg flex items-center justify-center shrink-0 mt-0.5">
								<Icon name="lucide:map-pin" width="14" height="14" />
							</span>
							Bajkalská 22, 821 09 Bratislava
						</div>
					</li>
				</ul>

				<!-- rychly dopyt -->
				<div class="mt-6">
					<p class="text-gray-400 text-xs font-semibold mb-2">Rýchly dopyt</p>
					<form class="flex gap-2" action="#" method="post" data-contact-form data-contact-kind="quick">
						<input type="text" name="website" autocomplete="off" tabindex="-1" hidden />
						<input
							type="email"
							name="email"
							placeholder="váš@email.sk"
							required
							class="flex-1 border rounded-lg px-3 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/20 transition-colors dopyt-input"
						/>
						<button
							type="submit"
							class="text-white px-3 py-2 rounded-lg text-sm font-semibold shrink-0 hover:opacity-90 transition-opacity duration-200"
							style="background:#D80B17"
						>
							→
						</button>
					</form>
					<p class="mt-2 min-h-4 text-xs font-semibold text-gray-400" data-contact-message role="status" aria-live="polite"></p>
				</div>
			</div>

		</div>
	</div>

	<!-- bottom bar -->
	<div class="border-t border-white/10">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-gray-500">
			<span>© 2026 Billboardy.sk. Všetky práva vyhradené.</span>
			<div class="flex gap-4">
				<a href="#" class="hover:text-gray-300 transition-colors duration-200">Ochrana osobných údajov</a>
				<a href="#" class="hover:text-gray-300 transition-colors duration-200">Obchodné podmienky</a>
				<a href="#" class="hover:text-gray-300 transition-colors duration-200">Cookies</a>
			</div>
		</div>
	</div>

</footer>

<script>
	const footerRegionLinks = document.querySelectorAll<HTMLAnchorElement>('[data-footer-region]');

	for (const link of footerRegionLinks) {
		link.addEventListener('click', (event) => {
			const mapRoot = document.querySelector('#billboardy-map-app');

			if (!mapRoot) {
				return;
			}

			event.preventDefault();

			const region = link.dataset.footerRegion ?? '';
			const targetId = document.getElementById('mapa') ? 'mapa' : 'plochy';
			const url = new URL(window.location.href);

			if (region) {
				url.searchParams.set('region', region);
			} else {
				url.searchParams.delete('region');
			}

			url.hash = targetId;
			window.history.replaceState({}, '', url);
			window.dispatchEvent(new CustomEvent('billboardy:hero-search', {
				detail: { region },
			}));
			document.getElementById(targetId)?.scrollIntoView({
				behavior: 'smooth',
				block: 'start',
			});
		});
	}
</script>

<style>
	.social-btn {
		background: rgba(255, 255, 255, 0.08);
	}
	.social-btn:hover {
		background: #D80B17;
	}
	.contact-icon {
		background: rgba(255, 255, 255, 0.08);
	}
	.dopyt-input {
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.1);
	}
</style>
