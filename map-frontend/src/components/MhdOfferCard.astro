---
import type { VehicleOffer } from "../data/mhdAdvertising";
import { POLEP_PRICE, discountPrice, formatEuro } from "../data/mhdAdvertising";

type Props = {
	offer: VehicleOffer;
};

const { offer } = Astro.props as Props;
const basePath = import.meta.env.BASE_URL;
const contactHref = `${basePath}kontakt/?typ=${encodeURIComponent(offer.title)}`;
---

<article id={offer.slug} class="flex h-full scroll-mt-36 flex-col overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
	<img
		src={offer.image}
		alt={offer.imageAlt}
		loading="lazy"
		decoding="async"
		class="aspect-[16/9] w-full bg-gray-100 object-cover"
	/>
	<div class="flex flex-1 flex-col p-5 sm:p-6">
		<div>
			<h3 class="text-xl font-black text-bb-ink">{offer.title}</h3>
			{offer.size && <p class="mt-1 text-sm font-bold text-brand">{offer.size}</p>}
			{offer.note && <p class="mt-3 text-sm leading-relaxed text-gray-500">{offer.note}</p>}
		</div>

		<div class="mt-5 overflow-x-auto rounded-xl border border-gray-100">
			<table class="w-full min-w-80 text-left text-sm" aria-label={`Cenník: ${offer.title}`}>
				<thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
					<tr>
						<th scope="col" class="px-4 py-3 font-extrabold">Dĺžka kampane</th>
						<th scope="col" class="px-4 py-3 text-right font-extrabold">Cena prenájmu / mesiac</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-100">
					{offer.prices.map(({ period, sourcePrice }) => (
						<tr>
							<th scope="row" class="px-4 py-3 font-semibold text-gray-600">{period}</th>
							<td class="whitespace-nowrap px-4 py-3 text-right font-black text-bb-ink">
								{formatEuro(discountPrice(sourcePrice))}
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<div class="mt-auto pt-4">
			<p class="text-sm font-extrabold text-gray-700">Polep: {formatEuro(POLEP_PRICE)} bez DPH</p>
			<a
				href={contactHref}
				class="mt-5 inline-flex w-full items-center justify-center rounded-xl bg-brand px-5 py-3 text-sm font-extrabold text-white transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
			>
				Vyžiadať ponuku
			</a>
		</div>
	</div>
</article>
