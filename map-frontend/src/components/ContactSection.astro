---
import { Icon } from 'astro-icon/components';

const AD_TYPES = [
  "Billboard",
  "Citylight",
  "Bigboard",
  "Most",
  "Plachta",
  "Fasáda",
  "Mega plocha",
  "Celé Slovensko / neviem",
];

const BUDGETS = [
  "do 200 €/mes",
  "200 – 500 €/mes",
  "500 – 1 000 €/mes",
  "1 000 – 3 000 €/mes",
  "3 000+ €/mes",
];

const REGIONS = [
  "Bratislavský kraj",
  "Trnavský kraj",
  "Trenčiansky kraj",
  "Nitriansky kraj",
  "Žilinský kraj",
  "Banskobystrický kraj",
  "Prešovský kraj",
  "Košický kraj",
  "Celé Slovensko",
];
---

<section id="kontakt" class="py-20" style="background:#f8f9fa;">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-12 max-w-xl">
      <p class="text-xs mb-2" style="font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--color-brand);">
        Kontakt
      </p>
      <h2 style="font-size:2rem;font-weight:900;color:var(--color-bb-ink);line-height:1.1;">
        Zašlite nám dopyt
      </h2>
      <p class="text-gray-500 mt-2 text-sm leading-relaxed">
        Vyplňte formulár a my vás do 24 hodín kontaktujeme s ponukou na mieru.
        Konzultácia je nezáväzná a bezplatná.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 items-start">

      <!-- Form column -->
      <div class="lg:col-span-3">

        <!-- Success state (hidden by default) -->
        <div
          id="contact-success"
          class="hidden bg-white rounded-2xl border border-gray-100 shadow-sm p-10 flex-col items-center text-center gap-4"
        >
          <div class="w-16 h-16 rounded-full flex items-center justify-center" style="background:rgba(15,139,95,0.1);">
            <Icon name="lucide:check-circle" class="size-8 text-bb-green" />
          </div>
          <div>
            <h3 style="font-weight:900;font-size:1.3rem;color:var(--color-bb-ink);">Dopyt odoslaný!</h3>
            <p class="text-gray-500 text-sm mt-2 max-w-sm">
              Ďakujeme, <strong data-success-name></strong>. Odpovieme do 24 hodín na <strong data-success-email></strong>.
            </p>
          </div>
          <button
            id="contact-reset"
            data-contact-reset
            class="mt-2 text-sm px-5 py-2 rounded-xl border border-gray-200 hover:bg-gray-50 transition-all"
            style="font-weight:700;color:#374151;"
          >
            Odoslať ďalší dopyt
          </button>
        </div>

        <!-- Form -->
        <form
          id="contact-form"
          data-contact-form
          data-contact-kind="contact"
          data-success-target="#contact-success"
          class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden"
          novalidate
        >
          <input type="text" name="website" autocomplete="off" tabindex="-1" hidden />
          <!-- Form header strip -->
          <div class="px-6 py-4 flex items-center gap-3 bg-bb-heading">
            <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background:var(--color-brand);">
              <Icon name="lucide:send" class="size-3.75 text-white" />
            </div>
            <div>
              <div style="font-weight:800;color:white;font-size:0.95rem;">Dopyt o reklamnú plochu</div>
              <div class="text-xs" style="color:rgba(255,255,255,0.5);">Odpovieme do 24 hodín</div>
            </div>
          </div>

          <div class="p-6 flex flex-col gap-5">

            <!-- Contact info -->
            <div>
              <p class="text-xs mb-3" style="font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.06em;">
                Kontaktné údaje
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                <!-- Name -->
                <div class="flex flex-col gap-1.5">
                  <label for="f-name" class="flex items-center gap-1.5 text-xs" style="font-weight:700;color:#374151;">
                    <Icon name="lucide:user" class="size-3.25 text-brand" />
                    Meno a priezvisko <span class="text-brand">*</span>
                  </label>
                  <input
                    id="f-name" name="name" type="text" required
                    placeholder="Ján Novák"
                    class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition-all placeholder-gray-400"
                    style="font-weight:500;"
                  />
                </div>

                <!-- Company -->
                <div class="flex flex-col gap-1.5">
                  <label for="f-company" class="flex items-center gap-1.5 text-xs" style="font-weight:700;color:#374151;">
                    <Icon name="lucide:building-2" class="size-3.25 text-brand" />
                    Spoločnosť
                  </label>
                  <input
                    id="f-company" name="company" type="text"
                    placeholder="Vaša s.r.o."
                    class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition-all placeholder-gray-400"
                    style="font-weight:500;"
                  />
                </div>

                <!-- Email -->
                <div class="flex flex-col gap-1.5">
                  <label for="f-email" class="flex items-center gap-1.5 text-xs" style="font-weight:700;color:#374151;">
                    <Icon name="lucide:mail" class="size-3.25 text-brand" />
                    E-mail <span class="text-brand">*</span>
                  </label>
                  <input
                    id="f-email" name="email" type="email" required
                    placeholder="jan@firma.sk"
                    class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition-all placeholder-gray-400"
                    style="font-weight:500;"
                  />
                </div>

                <!-- Phone -->
                <div class="flex flex-col gap-1.5">
                  <label for="f-phone" class="flex items-center gap-1.5 text-xs" style="font-weight:700;color:#374151;">
                    <Icon name="lucide:phone" class="size-3.25 text-brand" />
                    Telefón
                  </label>
                  <input
                    id="f-phone" name="phone" type="tel"
                    placeholder="+421 900 000 000"
                    class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition-all placeholder-gray-400"
                    style="font-weight:500;"
                  />
                </div>

              </div>
            </div>

            <!-- Campaign details -->
            <div>
              <p class="text-xs mb-3" style="font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:0.06em;">
                Detaily kampane
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                <!-- Ad type -->
                <div class="flex flex-col gap-1.5">
                  <label for="f-adtype" class="flex items-center gap-1.5 text-xs" style="font-weight:700;color:#374151;">
                    <Icon name="lucide:layout-grid" class="size-3.25 text-brand" />
                    Typ nositeľa
                  </label>
                  <div class="relative">
                    <select
                      id="f-adtype" name="adType"
                      class="w-full appearance-none bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 pr-10 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition-all"
                      
                    >
                      <option value="" disabled selected>Vyberte typ...</option>
                      {AD_TYPES.map((t) => <option value={t}>{t}</option>)}
                    </select>
                    <Icon name="lucide:chevron-down" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none size-3.75" />
                  </div>
                </div>

                <!-- Region -->
                <div class="flex flex-col gap-1.5">
                  <label for="f-region" class="flex items-center gap-1.5 text-xs" style="font-weight:700;color:#374151;">
                    <Icon name="lucide:map-pin" class="size-3.25 text-brand" />
                    Kraj / oblasť
                  </label>
                  <div class="relative">
                    <select
                      id="f-region" name="region"
                      class="w-full appearance-none bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 pr-10 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition-all"
                      
                    >
                      <option value="" disabled selected>Vyberte kraj...</option>
                      {REGIONS.map((r) => <option value={r}>{r}</option>)}
                    </select>
                    <Icon name="lucide:chevron-down" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none size-3.75" />
                  </div>
                </div>

                <!-- Budget -->
                <div class="flex flex-col gap-1.5">
                  <label for="f-budget" class="flex items-center gap-1.5 text-xs" style="font-weight:700;color:#374151;">
                    <Icon name="lucide:euro" class="size-3.25 text-brand" />
                    Mesačný rozpočet
                  </label>
                  <div class="relative">
                    <select
                      id="f-budget" name="budget"
                      class="w-full appearance-none bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 pr-10 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition-all"
                      
                    >
                      <option value="" disabled selected>Vyberte rozpočet...</option>
                      {BUDGETS.map((b) => <option value={b}>{b}</option>)}
                    </select>
                    <Icon name="lucide:chevron-down" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none size-3.75" />
                  </div>
                </div>

                <!-- Start date -->
                <div class="flex flex-col gap-1.5">
                  <label for="f-date" class="flex items-center gap-1.5 text-xs" style="font-weight:700;color:#374151;">
                    <Icon name="lucide:calendar" class="size-3.25 text-brand" />
                    Plánovaný začiatok
                  </label>
                  <input
                    id="f-date" name="startDate" type="date"
                    class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition-all"
                    style="font-weight:500;"
                  />
                </div>

              </div>
            </div>

            <!-- Message -->
            <div class="flex flex-col gap-1.5">
              <label for="f-message" class="flex items-center gap-1.5 text-xs" style="font-weight:700;color:#374151;">
                <Icon name="lucide:message-square" class="size-3.25 text-brand" />
                Správa / požiadavky
              </label>
              <textarea
                id="f-message" name="message" rows="4"
                placeholder="Popíšte vašu kampaň, cieľovú skupinu, požiadavky na lokalitu alebo akékoľvek doplňujúce informácie..."
                class="bg-gray-50 border border-gray-200 rounded-xl px-4 py-3 text-sm text-gray-800 focus:outline-none focus:ring-2 focus:ring-brand focus:border-transparent transition-all placeholder-gray-400 resize-none"
                style="font-weight:500;"
              ></textarea>
            </div>

            <!-- GDPR checkbox -->
            <label class="flex items-start gap-3 cursor-pointer select-none">
              <input
                type="checkbox"
                id="f-gdpr"
                name="gdpr"
                class="mt-0.5 shrink-0 cursor-pointer"
                style="width:20px;height:20px;min-width:20px;accent-color:var(--color-brand);"
                required
              />
              <span class="text-xs text-gray-500 leading-relaxed" style="font-weight:500;">
                Súhlasím so{" "}
                <a href="/gdprcookies" class="underline text-brand">spracovaním osobných údajov</a>{" "}
                v súlade s GDPR. Vaše údaje slúžia výhradne na vybavenie dopytu a nebudú
                poskytnuté tretím stranám.
              </span>
            </label>

            <!-- Submit -->
            <p class="min-h-5 text-sm font-bold text-gray-500" data-contact-message role="status" aria-live="polite"></p>
            <button
              id="contact-submit"
              type="submit"
              disabled
              class="w-full py-3.5 rounded-xl text-white flex items-center justify-center gap-2 transition-all disabled:opacity-40 disabled:cursor-not-allowed hover:opacity-90"
              style="font-weight:700;background:var(--color-brand);font-size:0.95rem;"
            >
              <span id="submit-idle" class="flex items-center gap-2" data-submit-idle>
                <Icon name="lucide:send" class="size-3.75" />
                Odoslať dopyt
              </span>
              <span id="submit-loading" class="hidden items-center gap-2" data-submit-loading>
                <svg class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <circle cx="12" cy="12" r="10" stroke="white" stroke-width="3" stroke-dasharray="60" stroke-dashoffset="20" />
                </svg>
                Odosielam...
              </span>
            </button>

          </div>
        </form>
      </div>

      <!-- Right info panel -->
      <div class="lg:col-span-2 flex flex-col gap-4">

        <!-- Photo card -->
        <div class="rounded-2xl overflow-hidden relative h-44 shadow-sm">
          <img
            src="/kpk.webp"
            alt="KPK reklama logo"
            class="w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/10"></div>
     
        </div>

        <!-- Contact details -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 flex flex-col gap-4">
          <p class="text-xs" style="font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;">
            Priamy kontakt
          </p>

          <a href="tel:+421917545003" class="flex items-center gap-3 group">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0" style="background:rgba(15,139,95,0.08);">
              <Icon name="lucide:phone" class="size-4 text-bb-green" />
            </div>
            <div>
              <div class="text-xs text-gray-400" style="font-weight:600;">Telefón</div>
              <div class="text-sm group-hover:underline transition-all" style="font-weight:700;color:var(--color-bb-ink);">+ 421 917 545 003</div>
            </div>
          </a>

          <a href="mailto:info@kpkreklama.sk" class="flex items-center gap-3 group">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0" style="background:rgba(16,110,190,0.08);">
              <Icon name="lucide:mail" class="size-4 text-bb-focus" />
            </div>
            <div>
              <div class="text-xs text-gray-400" style="font-weight:600;">E-mail</div>
              <div class="text-sm group-hover:underline transition-all" style="font-weight:700;color:var(--color-bb-ink);">info@kpkreklama.sk</div>
            </div>
          </a>

          <div class="flex items-center gap-3 group">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0" style="background:rgba(216,11,23,0.08);">
              <Icon name="lucide:receipt-euro" class="size-4 text-brand" />
            </div>
            <div>
              <div class="text-xs text-gray-400" style="font-weight:600;">Fakturačná adresa</div>
              <div class="text-sm  transition-all" style="font-weight:700;color:var(--color-bb-ink);">
                KPK Print s.r.o. <br>
                Orlia 10, 040 01 Košice – Staré mesto <br>
                IČO: 44432291 <br>
                IČ DPH: SK2022695719
            </div>
            </div>
          </div>
        <div class="flex items-center gap-3 group">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0" style="background:rgba(216, 144, 11, 0.08);">
              <Icon name="lucide:map-pin" class="size-4 text-bb-yellow" />
            </div>
            <div>
              <div class="text-xs text-gray-400" style="font-weight:600;">Prevádzka</div>
              <div class="text-sm  transition-all" style="font-weight:700;color:var(--color-bb-ink);">
                Rozvojová 2 <br>
                040 11 Košice <br>
            </div>
            </div>
        </div>
        </div>

        <!-- Working hours -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5">
          <p class="text-xs mb-3" style="font-weight:700;text-transform:uppercase;letter-spacing:0.07em;color:#6b7280;">
            Pracovné hodiny
          </p>
          <div class="flex flex-col gap-1.5">
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-500">Pondelok – Piatok</span>
              <span style="font-weight:700;color:var(--color-bb-ink);">8:00 – 16:00</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-500">Sobota</span>
              <span style="font-weight:700;color:#9ca3af;">Zatvorené</span>
            </div>
            <div class="flex items-center justify-between text-sm">
              <span class="text-gray-500">Nedeľa</span>
              <span style="font-weight:700;color:#9ca3af;">Zatvorené</span>
            </div>
          </div>
          <div class="mt-4 flex items-center gap-2 px-3 py-2 rounded-xl" style="background:rgba(15,139,95,0.08);">
            <div class="w-2 h-2 rounded-full animate-pulse" style="background:#0F8B5F;"></div>
            <span class="text-xs" style="font-weight:700;color:var(--color-bb-green);">Priemerná odpoveď do 4 hodín</span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
