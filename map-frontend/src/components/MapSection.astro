---
import { Icon } from "astro-icon/components";

const initialFilters = [
	{ label: "Všetky", value: "" },
	{ label: "Billboard", value: "billboard" },
	{ label: "Bigboard", value: "bigboard" },
	{ label: "Citylight", value: "citylight" },
];
---

<section id="mapa" class="bb-map-section" aria-labelledby="bb-map-title">
	<div id="billboardy-map-app" class="bb-map-app">
		<div class="bb-map-container">
			<header class="bb-map-header">
				<div>
					<h2 id="bb-map-title">Reklamné plochy na mape</h2>
					<p class="bb-map-summary" data-map-summary>Načítavam reklamné plochy...</p>
				</div>

				<button class="bb-map-filter-toggle" type="button" data-filter-toggle aria-controls="bb-map-advanced" aria-expanded="false">
					<Icon name="lucide:sliders-horizontal" width="16" height="16" />
					<span>Filtre</span>
				</button>
			</header>

			<form class="bb-map-filters" aria-label="Filtre reklamných plôch">
				<select class="bb-map-native-media-select" name="media_type" aria-label="Typ plochy" hidden>
					{initialFilters.map((filter, index) => (
						<option value={filter.value}>{index === 0 ? "Všetky typy" : filter.label}</option>
					))}
				</select>

				<div class="bb-map-filter-pills" data-map-filter-pills aria-label="Typ plochy">
					{initialFilters.map((filter, index) => (
						<button
							type="button"
							class:list={["bb-map-filter-pill", index === 0 && "is-active"]}
							data-filter-value={filter.value}
							aria-pressed={index === 0 ? "true" : "false"}
						>
							{filter.label}
						</button>
					))}
				</div>

				<div id="bb-map-advanced" class="bb-map-advanced" hidden>
					<label>
						<span>Mesto</span>
						<select name="city" disabled>
							<option value="">Všetky mestá</option>
						</select>
					</label>

					<label class="bb-map-search">
						<span>Vyhľadávanie</span>
						<input name="search" type="search" autocomplete="off" placeholder="Kód alebo lokalita" />
					</label>

					<button class="bb-map-reset" type="reset">Zrušiť filtre</button>
				</div>
			</form>

			<div class="bb-map-layout">
				<aside class="bb-map-results" aria-label="Výber v aktuálnej oblasti" hidden>
					<div class="bb-map-results-head">
						<h3>Výber v aktuálnej oblasti</h3>
						<p>Priblížte mapu pre výber plôch v aktuálnej oblasti.</p>
					</div>
					<div class="bb-map-results-list"></div>
				</aside>

				<div class="bb-map-stage">
					<div class="bb-map-status" role="status" aria-live="polite">Načítavam reklamné plochy...</div>
					<div class="bb-map-canvas" aria-label="Mapa reklamných plôch"></div>
				</div>
			</div>
		</div>
	</div>

	<script>
		import "../scripts/map";
	</script>
</section>
