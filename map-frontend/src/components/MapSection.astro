---
interface Props {
	id?: string;
	title?: string;
	summary?: string;
	initialMediaType?: string;
	filterLabel?: string;
	lockMediaType?: boolean;
	hideMediaFilters?: boolean;
}

const {
	id = "mapa",
	title = "Interaktívna mapa reklamných ploch",
	summary = "Vyberte si vhodnú reklamnú plochu na interaktívnej mape a odošlite nezáväznú žiadosť o rezerváciu. Nájdite billboardy, bigboardy, citylighty a ďalšie vonkajšie reklamné plochy podľa lokality, typu nosiča a dostupnosti.",
	initialMediaType = "",
	filterLabel = "",
	lockMediaType = false,
	hideMediaFilters = false,
} = Astro.props;

const initialFilters = [
	{ label: "Všetky", value: "" },
	{ label: "Billboard", value: "billboard" },
	{ label: "Citylight", value: "citylight" },
	{ label: "Bigboard", value: "bigboard" },
	{ label: "Most", value: "bridge" },
	{ label: "Plachta", value: "banner" },
	{ label: "Fasáda", value: "facade" },
	{ label: "Mega plocha", value: "mega" },
];

const selectedFilter = initialFilters.find((filter) => filter.value === initialMediaType);
const lockedFilterLabel = filterLabel || selectedFilter?.label || "Vybraný typ";
---

<section id={id} class="bb-map-section" aria-labelledby="bb-map-title">
	<div
	id="billboardy-map-app"
	class="bb-map-app"
	data-initial-media-type={initialMediaType}
	data-initial-media-label={lockedFilterLabel}
	data-lock-media-type={lockMediaType ? "true" : "false"}
>
		<div class="bb-map-container">
			<header class="bb-map-header">
				<div>
					<h2 id="bb-map-title">{title}</h2>
					<p class="bb-map-summary max-w-4xl">{summary}</p>
				</div>
			</header>

			<form class="bb-map-filters" aria-label="Filtre reklamných plôch">
				<select class="bb-map-native-media-select" name="media_type" aria-label="Typ plochy" hidden>
					{initialFilters.map((filter, index) => (
						<option value={filter.value} selected={filter.value === initialMediaType}>
							{index === 0 ? "Všetky typy" : filter.label}
						</option>
					))}
				</select>

				{
					hideMediaFilters ? null : lockMediaType ? (
						<div class="bb-map-filter-lock">
							<span>Filter: {lockedFilterLabel}</span>
						</div>
					) : (
						<div class="bb-map-filter-pills" data-map-filter-pills aria-label="Typ plochy">
							{initialFilters.map((filter) => (
								<button
									type="button"
									class:list={["bb-map-filter-pill", filter.value === initialMediaType && "is-active"]}
									data-filter-value={filter.value}
									aria-pressed={filter.value === initialMediaType ? "true" : "false"}
								>
									{filter.label}
								</button>
							))}
						</div>
					)
				}
			</form>

			<div class="bb-map-layout">
				<aside class="bb-map-results" aria-label="Výber v aktuálnej oblasti" hidden>
					<div class="bb-map-results-head">
						<div class="bb-map-results-title-row">
							<h3>Výber v aktuálnej oblasti</h3>
							<div class="bb-map-results-actions">
								<button
									type="button"
									class="bb-map-results-toggle"
									data-map-results-toggle
									aria-label="Rozbaliť zoznam"
									aria-expanded="false"
									title="Rozbaliť zoznam"
								><span aria-hidden="true"></span></button>
								<button
									type="button"
									class="bb-map-zoom-out"
									data-map-zoom-out
									aria-label="Oddialiť mapu"
									title="Oddialiť mapu"
								><span aria-hidden="true">←</span></button>
							</div>
						</div>
						<p>Priblížte mapu pre výber plôch v aktuálnej oblasti.</p>
					</div>
					<div class="bb-map-results-list"></div>
				</aside>

				<div class="bb-map-stage">
					<div class="bb-map-status" role="status" aria-live="polite">Načítavam reklamné plochy...</div>
					<div class="bb-map-canvas" aria-label="Mapa reklamných plôch"></div>
					<div class="bb-map-street-view-point" hidden></div>
				</div>
			</div>
		</div>
	</div>

	<script>
		import "../scripts/map";
	</script>
</section>
