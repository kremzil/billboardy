---
import { Icon } from 'astro-icon/components'

const HERO_BG = "https://images.unsplash.com/photo-1745941052300-33d18cadb27e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxicmF0aXNsYXZhJTIwc2xvdmFraWElMjBjaXR5JTIwc2t5bGluZXxlbnwxfHx8fDE3NzY4NDc1NzZ8MA&ixlib=rb-4.1.0&q=80&w=1920";

const CITY_OPTIONS = ['Bratislava', 'Košice', 'Žilina', 'Nitra', 'Banská Bystrica', 'Prešov']
const TYPE_OPTIONS = ['Všetky typy', 'Billboard', 'LED obrazovka', 'Citylight', 'MHD']
const STATS = [
  { value: '1 200+', label: 'Reklamných plôch' },
  { value: '50+', label: 'Miest na Slovensku' },
  { value: '98%', label: 'Spokojnosť klientov' },
  { value: '24h', label: 'Rýchle schválenie' },
]
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- bg -->
  <div class="absolute inset-0">
    <img src={HERO_BG} alt="Bratislava city skyline" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-linear-to-b from-black/60 via-black/50 to-black/70" />
  </div>

  <!-- content -->
  <div class="relative z-10 text-center px-4 max-w-5xl mx-auto pt-20">
    <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white/90 px-4 py-1.5 rounded-full text-sm mb-6">
      <span class="w-2 h-2 rounded-full animate-pulse bg-bb-yellow"></span>
      Prémiové reklamné plochy na Slovensku
    </div>

    <h1 class="text-white mb-4 text-[clamp(2rem,5vw,3.5rem)] font-extrabold leading-[1.1]">
      Nájdite ideálnu<br />
      <span class="text-bb-yellow">reklamnú plochu</span>
    </h1>
    <p class="text-gray-300 mb-10 max-w-2xl mx-auto text-[1.1rem]">
      Viac ako 1 200 reklamných plôch po celom Slovensku. Billboardy, LED obrazovky, citylighty a ďalšie.
      Transparentná cena, okamžité rezervovanie.
    </p>

    <div class="bg-white rounded-2xl shadow-2xl p-2 max-w-3xl mx-auto">
      <form class="flex flex-col sm:flex-row gap-0 divide-y sm:divide-y-0 sm:divide-x divide-gray-200" action="#mapa" method="get">
        <div class="flex-1 px-4 py-3 flex items-center gap-3">
          <Icon name="lucide:map-pin" width="18" height="18" class="shrink-0 text-brand" />
          <div class="flex-1 text-left">
            <div class="text-xs text-gray-500 mb-0.5 font-semibold uppercase tracking-[0.05em]">Mesto</div>
            <select name="mesto" class="w-full bg-transparent text-gray-800 text-sm outline-none cursor-pointer font-medium">
              <option value="">Vyberte mesto...</option>
              {CITY_OPTIONS.map(c => (
                <option value={c}>{c}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex-1 px-4 py-3 flex items-center gap-3">
          <Icon name="lucide:chevron-down" width="18" height="18" class="shrink-0 text-brand" />
          <div class="flex-1 text-left">
            <div class="text-xs text-gray-500 mb-0.5 font-semibold uppercase tracking-[0.05em]">Typ plochy</div>
            <select name="typ" class="w-full bg-transparent text-gray-800 text-sm outline-none cursor-pointer font-medium">
              {TYPE_OPTIONS.map(t => (
                <option value={t}>{t}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex-1 px-4 py-3 flex items-center gap-3">
          <Icon name="lucide:calendar" width="18" height="18" class="shrink-0 text-brand" />
          <div class="flex-1 text-left">
            <div class="text-xs text-gray-500 mb-0.5 font-semibold uppercase tracking-[0.05em]">Termín</div>
            <input type="month" name="termin" class="w-full bg-transparent text-gray-800 text-sm outline-none font-medium" />
          </div>
        </div>

        <div class="px-2 py-2 flex items-center">
          <button type="submit" class="bg-brand text-white px-6 py-3 rounded-xl flex items-center justify-center gap-2 transition-all duration-200 w-full sm:w-auto hover:opacity-90">
            <Icon name="lucide:search" width="18" height="18" />
            <span class="font-semibold">Hľadať</span>
          </button>
        </div>
      </form>
    </div>

    <div class="flex flex-wrap justify-center gap-8 mt-10">
      {STATS.map(stat => (
        <div class="text-center">
          <div class="text-[1.75rem] font-extrabold text-bb-yellow">{stat.value}</div>
          <div class="text-gray-400 text-sm mt-0.5">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/60">
    <span class="text-xs tracking-widest">SCROLL</span>
    <div class="w-px h-8 bg-linear-to-b from-white/40 to-transparent"></div>
  </div>
</section>