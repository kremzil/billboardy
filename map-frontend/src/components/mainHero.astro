---
import { Icon } from 'astro-icon/components'

const HERO_BG = "./main-hero.webp";

const REGION_OPTIONS = [
  { value: '', label: 'Celé Slovensko' },
  { value: 'bratislavsky', label: 'Bratislavský kraj' },
  { value: 'trnavsky', label: 'Trnavský kraj' },
  { value: 'trenciansky', label: 'Trenčiansky kraj' },
  { value: 'nitriansky', label: 'Nitriansky kraj' },
  { value: 'zilinsky', label: 'Žilinský kraj' },
  { value: 'banskobystricky', label: 'Banskobystrický kraj' },
  { value: 'presovsky', label: 'Prešovský kraj' },
  { value: 'kosicky', label: 'Košický kraj' },
]
const TYPE_OPTIONS = [
  { value: '', label: 'Všetky typy' },
  { value: 'billboard', label: 'Billboard' },
  { value: 'citylight', label: 'Citylight' },
  { value: 'bigboard', label: 'Bigboard' },
  { value: 'bridge', label: 'Most' },
  { value: 'banner', label: 'Plachta' },
  { value: 'facade', label: 'Fasáda' },
  { value: 'mega', label: 'Mega plocha' },
]
const STATS = [
  { value: '1 200+', label: 'Reklamných plôch' },
  { value: '50+', label: 'Miest na Slovensku' },
  { value: '98%', label: 'Spokojnosť klientov' },
  { value: '24h', label: 'Rýchle schválenie' },
]
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- bg -->
  <div class="absolute inset-0">
    <img src={HERO_BG} alt="Bratislava city skyline" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-linear-to-b from-black/60 via-black/50 to-black/70" />
  </div>

  <!-- content -->
  <div class="relative z-10 text-center px-4 max-w-5xl mx-auto pt-20">
    <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white/90 px-4 py-1.5 rounded-full text-sm mb-6">
      <span class="w-2 h-2 rounded-full animate-pulse bg-bb-yellow"></span>
      Prémiové reklamné plochy na Slovensku
    </div>

    <h1 class="text-white mb-4 text-[clamp(2rem,5vw,3.5rem)] font-extrabold leading-[1.1]">
      Nájdite ideálnu<br />
      <span class="text-bb-yellow">reklamnú plochu</span>
    </h1>
    <p class="text-gray-300 mb-10 max-w-2xl mx-auto text-[1.1rem]">
      Viac ako 1 200 reklamných plôch po celom Slovensku. Billboard, Citylight, Bigboard, Plachta a ďalšie.
      Transparentná cena, okamžité rezervovanie.
    </p>

    <div class="bg-white rounded-2xl shadow-2xl p-2 max-w-3xl mx-auto">
      <form class="flex flex-col sm:flex-row gap-0 divide-y sm:divide-y-0 sm:divide-x divide-gray-200" action="#mapa" method="get" data-hero-map-search>
        <div class="flex-1 px-4 py-3 flex items-center gap-3">
          <Icon name="lucide:map-pin" width="18" height="18" class="shrink-0 text-brand" />
          <div class="flex-1 text-left">
            <div class="text-xs text-gray-500 mb-0.5 font-semibold uppercase tracking-[0.05em]">Kraj</div>
            <select name="region" class="w-full bg-transparent text-gray-800 text-sm outline-none cursor-pointer font-medium">
              {REGION_OPTIONS.map(region => (
                <option value={region.value}>{region.label}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="flex-1 px-4 py-3 flex items-center gap-3">
          <Icon name="lucide:chevron-down" width="18" height="18" class="shrink-0 text-brand" />
          <div class="flex-1 text-left">
            <div class="text-xs text-gray-500 mb-0.5 font-semibold uppercase tracking-[0.05em]">Typ plochy</div>
            <select name="media_type" class="w-full bg-transparent text-gray-800 text-sm outline-none cursor-pointer font-medium">
              {TYPE_OPTIONS.map(type => (
                <option value={type.value}>{type.label}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="px-2 py-2 flex items-center">
          <button type="submit" class="btn">
            <Icon name="lucide:search" width="18" height="18" />
            <span class="font-semibold">Hľadať</span>
          </button>
        </div>
      </form>
    </div>

    <div class="flex flex-wrap justify-center gap-8 mt-10">
      {STATS.map(stat => (
        <div class="text-center">
          <div class="text-[1.75rem] font-extrabold text-bb-yellow">{stat.value}</div>
          <div class="text-gray-400 text-sm mt-0.5">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/60">
    <span class="text-xs tracking-widest">SCROLL</span>
    <div class="w-px h-8 bg-linear-to-b from-white/40 to-transparent"></div>
  </div>
</section>

<script>
  const heroSearchForm = document.querySelector<HTMLFormElement>('[data-hero-map-search]');

  heroSearchForm?.addEventListener('submit', (event) => {
    event.preventDefault();

    const formData = new FormData(heroSearchForm);
    const region = String(formData.get('region') ?? '').trim();
    const mediaType = String(formData.get('media_type') ?? '').trim();
    const url = new URL(window.location.href);

    if (region) {
      url.searchParams.set('region', region);
    } else {
      url.searchParams.delete('region');
    }

    if (mediaType) {
      url.searchParams.set('media_type', mediaType);
    } else {
      url.searchParams.delete('media_type');
    }

    url.hash = 'mapa';
    window.history.replaceState({}, '', url);

    window.dispatchEvent(new CustomEvent('billboardy:hero-search', {
      detail: {
        region,
        mediaType,
      },
    }));

    document.getElementById('mapa')?.scrollIntoView({
      behavior: 'smooth',
      block: 'start',
    });
  });
</script>
