---

<section class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-12">
      <p class="text-xs mb-2" style="font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--color-brand);">
        Tím
      </p>
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <h2 style="font-size:2rem;font-weight:900;color:var(--color-bb-ink);line-height:1.1;">
          Náš tím
        </h2>
        <p class="text-gray-400 text-sm max-w-sm leading-relaxed">
          Sme tím odborníkov s viac ako 10 rokmi skúseností v oblasti vonkajšej reklamy na Slovensku.
        </p>
      </div>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
      {TEAM.map((member) => (
        <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md transition-shadow duration-200">
          <!-- Photo -->
          <div class="w-full overflow-hidden" style="aspect-ratio:1/1;background:#e8e8e8;">
            <img
              src={member.photo}
              alt={member.name}
              class="w-full h-full object-cover object-top"
              loading="lazy"
            />
          </div>

          <!-- Info -->
          <div class="px-4 pt-4 pb-5 flex flex-col gap-2">
            <div style={`font-weight:800;color:var(--color-bb-ink);font-size:1rem;line-height:1.25;`}>
              {member.name}
            </div>
            <div class="text-xs leading-snug" style={`font-weight:600;color:${member.roleColor};`}>
              {member.role}
            </div>

            <div class="border-t border-gray-100 my-0.5"></div>

            <a
              href={`mailto:${member.email}`}
              class="flex items-center gap-2 text-xs text-gray-500 hover:text-bb-focus transition-colors"
              style="font-weight:500;"
            >
              <Icon name="lucide:mail" class="shrink-0 text-gray-400 size-3" />
              <span class="truncate">{member.email}</span>
            </a>

            <a
              href={`tel:${member.phone.replace(/\s/g, "")}`}
              class="flex items-center gap-2 text-xs text-gray-500 hover:text-bb-focus transition-colors"
              style="font-weight:500;"
            >
              <Icon name="lucide:phone" class="shrink-0 text-gray-400 size-3" />
              <span>{member.phone}</span>
            </a>
          </div>
        </div>
      ))}
    </div>


  </div>
</section>
